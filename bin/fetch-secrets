#!/usr/bin/env bash
# fetch-secrets: Pull Stripe credentials from 1Password and inject into .env
set -euo pipefail

# Ensure we are in the packablock-web root directory
cd "$(dirname "$0")/.."

echo "🔑 Authenticating with 1Password and pulling Stripe sandbox keys..."
if op inject -i .env.template -o .env; then
  echo "✅ Success! Stripe sandbox secrets have been written to .env"
else
  echo "❌ Error: Failed to pull secrets from 1Password. Make sure op is logged in." >&2
  exit 1
fi
