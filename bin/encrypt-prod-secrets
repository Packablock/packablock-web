#!/usr/bin/env bash
# encrypt-prod-secrets: Pull Stripe production credentials from 1Password, encrypt via GCP KMS, and output ciphertext
set -euo pipefail

# Read KMS configuration with defaults
GCP_PROJECT_ID="${GCP_PROJECT_ID:-adwb-4444}"
GCP_KMS_LOCATION="${GCP_KMS_LOCATION:-us-west1}"
GCP_KMS_KEY_RING="${GCP_KMS_KEY_RING:-packablock-keyring}"
GCP_KMS_KEY_NAME="${GCP_KMS_KEY_NAME:-stripe-secret-key}"

echo "🔒 Pulling Stripe production secret key from 1Password..."
if ! prod_secret=$(op read "op://dev/stripe packablock/password"); then
  echo "❌ Error: Failed to pull Stripe production key from 1Password." >&2
  exit 1
fi

echo "🛡️ Encrypting secret key via Google Cloud KMS..."
if ! ciphertext=$(echo -n "$prod_secret" | gcloud kms encrypt \
  --location="$GCP_KMS_LOCATION" \
  --keyring="$GCP_KMS_KEY_RING" \
  --key="$GCP_KMS_KEY_NAME" \
  --plaintext-file=- \
  --ciphertext-file=- \
  --project="$GCP_PROJECT_ID" | base64 -w 0); then
  echo "❌ Error: KMS encryption failed. Make sure you are logged in to gcloud and the key exists." >&2
  exit 1
fi

echo "========================================================================"
echo "✅ Encryption Successful!"
echo "========================================================================"
echo "Ciphertext (Base64):"
echo "$ciphertext"
echo "------------------------------------------------------------------------"
echo "Update Cloud Run env vars with:"
echo "gcloud run services update packablock-web \\"
echo "  --set-env-vars=\"STRIPE_PROD_SECRET_KEY_CIPHERTEXT=$ciphertext\" \\"
echo "  --set-env-vars=\"GCP_PROJECT_ID=$GCP_PROJECT_ID\" \\"
echo "  --set-env-vars=\"GCP_KMS_LOCATION=$GCP_KMS_LOCATION\" \\"
echo "  --set-env-vars=\"GCP_KMS_KEY_RING=$GCP_KMS_KEY_RING\" \\"
echo "  --set-env-vars=\"GCP_KMS_KEY_NAME=$GCP_KMS_KEY_NAME\" \\"
echo "  --region=\"$GCP_KMS_LOCATION\""
echo "========================================================================"
