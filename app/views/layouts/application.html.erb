<!DOCTYPE html>
<html>
  <head>
    <title><%= (dev_instance? ? "[dev] " : "") + (content_for(:title) || "Packablock Web") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Packablock Web">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=IBM+Plex+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=block" rel="stylesheet">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans antialiased">
    <% if admin_signed_in? %>
      <header class="border-b border-slate-200 bg-white/80 backdrop-blur-md sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <a href="<%= dashboard_path %>" class="flex items-center gap-2.5 font-black text-lg tracking-wider text-slate-900 uppercase hover:opacity-90">
          <svg class="w-6 h-6 text-[#10b981]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" fill="none" stroke="none" role="img" aria-label="Packablock registry mark">
            <line x1="40" y1="36" x2="40" y2="84" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
            <circle cx="40" cy="42" r="6" fill="currentColor"/><circle cx="40" cy="60" r="6" fill="currentColor"/><circle cx="40" cy="78" r="6" fill="currentColor"/>
            <rect x="50" y="36.5" width="42" height="11" rx="4" fill="currentColor"/>
            <rect x="50" y="54.5" width="28" height="11" rx="4" fill="currentColor"/>
            <rect x="50" y="72.5" width="36" height="11" rx="4" fill="currentColor"/>
          </svg>
          Packablock <span class="font-mono text-[#10b981] text-sm font-medium">[<%= org_or_email_for(current_admin) %>]</span>
        </a>
        <nav class="flex items-center gap-6">
          <%= link_to "Dashboard", dashboard_path, class: "text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors" %>
          <button id="nav-install-trigger" class="text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors cursor-pointer bg-transparent border-0 p-0">Install</button>
          <%= link_to "Create Project", new_project_path, class: "text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors" %>
          
          <div class="h-4 w-px bg-slate-200"></div>
          
          <div class="flex items-center gap-2">
            <% if dev_instance? %>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-600 border border-amber-500/20 text-[10px] font-bold uppercase tracking-wider mr-1 select-none animate-pulse">
                <span class="w-1 h-1 rounded-full bg-amber-500"></span>
                dev
              </span>
            <% end %>
            <!-- Notification Dropdown -->
            <div class="relative flex items-center mr-2" id="notification-dropdown-container">
              <!-- Combined Notification Trigger Button -->
              <button id="notification-trigger" class="relative flex items-center gap-1.5 p-1.5 text-slate-600 hover:text-slate-800 rounded-lg hover:bg-slate-100 transition-all focus:outline-none cursor-pointer" aria-label="Notifications">
                <div class="relative flex items-center justify-center pointer-events-none">
                  <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a9.049 9.049 0 0 1-5.12 0m-.075-12.648a3.001 3.001 0 1 1 5.96 0M12 18.75V16.5m-9-4.5h18M5.25 12h13.5A2.25 2.25 0 0 0 21 9.75V9A6 6 0 0 0 9 9v.75A2.25 2.25 0 0 0 11.25 12Z" />
                  </svg>
                  <% if notice.present? || alert.present? %>
                    <span id="notification-dot" class="absolute top-0 right-0 flex h-2 w-2 pointer-events-none transition-opacity duration-300">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                    </span>
                  <% end %>
                </div>
                
                <svg class="w-3.5 h-3.5 transition-transform duration-200 pointer-events-none" id="notification-arrow-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </button>
              
              <!-- Redesigned Dropdown Notification Panel -->
              <div id="notification-panel" class="hidden absolute right-0 top-full mt-3 w-80 rounded-xl border border-slate-200 bg-white/95 backdrop-blur-md p-4 shadow-xl ring-1 ring-black/5 z-50 transition-all duration-200 origin-top-right transform scale-95 opacity-0">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
                  <span class="text-[10px] font-bold text-slate-600 uppercase tracking-wider">System Alerts</span>
                  <% if notice.present? || alert.present? %>
                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-rose-50 border border-rose-100 text-rose-600 uppercase">Active</span>
                  <% end %>
                </div>
                
                <div class="flex flex-col gap-2.5 max-h-60 overflow-y-auto">
                  <% if notice.present? %>
                    <div class="alert-item p-3 rounded-lg bg-emerald-50/80 border border-emerald-100/50 text-emerald-800 text-xs font-medium flex flex-col gap-2 shadow-sm transition-all duration-300">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <div class="flex-shrink-0 w-4 h-4 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-[9px]">✓</div>
                          <span class="font-bold text-[10px] text-emerald-900 uppercase">System Notice</span>
                        </div>
                        <span class="alert-seen-badge text-[8px] font-bold px-1.5 py-0.2 rounded bg-emerald-100/80 text-emerald-800 uppercase tracking-wider">New</span>
                      </div>
                      <div class="flex-1 leading-normal text-slate-700 font-normal"><%= notice %></div>
                    </div>
                  <% end %>
                  
                  <% if alert.present? %>
                    <div class="alert-item p-3 rounded-lg bg-rose-50/80 border border-rose-100/50 text-rose-800 text-xs font-medium flex flex-col gap-2 shadow-sm transition-all duration-300">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <div class="flex-shrink-0 w-4 h-4 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-[9px]">!</div>
                          <span class="font-bold text-[10px] text-rose-900 uppercase">System Alert</span>
                        </div>
                        <span class="alert-seen-badge text-[8px] font-bold px-1.5 py-0.2 rounded bg-rose-100/80 text-rose-800 uppercase tracking-wider">New</span>
                      </div>
                      <div class="flex-1 leading-normal text-slate-700 font-normal"><%= alert %></div>
                    </div>
                  <% end %>
                  
                  <% if !notice.present? && !alert.present? %>
                    <div class="py-6 text-center text-slate-600 flex flex-col items-center justify-center gap-2">
                      <svg class="w-7 h-7 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                      </svg>
                      <span class="text-xs">No active alerts</span>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
 
            <!-- Admin Dropdown Menu -->
            <div class="relative flex items-center" id="admin-dropdown-container">
              <button id="admin-trigger" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border transition-all focus:outline-none cursor-pointer text-xs font-semibold uppercase <%= current_admin.superuser? ? 'border-blue-500/30 bg-blue-500/10 text-blue-600 hover:bg-blue-500/20' : 'border-slate-200 bg-slate-100 text-slate-700 hover:bg-slate-200' %>" aria-label="Admin Action Menu">
                <span>
                  <% if current_admin.superuser? %>
                    Root Admin
                  <% else %>
                    <%= current_admin.email.split('@').last.split('.').first.capitalize %> Org
                  <% end %>
                </span>
                <svg class="w-3.5 h-3.5 transition-transform duration-200 pointer-events-none" id="admin-arrow-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </button>
 
              <!-- Dropdown Admin Panel -->
              <div id="admin-panel" class="hidden absolute right-0 top-full mt-3 w-80 rounded-xl border border-slate-200 bg-white/95 backdrop-blur-md p-3 shadow-xl ring-1 ring-black/5 z-50 transition-all duration-200 origin-top-right transform scale-95 opacity-0">
                <div class="px-3 py-2.5 border-b border-slate-100 mb-2">
                  <span class="text-[10px] font-bold text-slate-600 uppercase tracking-wider block mb-0.5">Signed in as</span>
                  <span class="text-sm font-semibold text-slate-800 block truncate" title="<%= current_admin.email %>"><%= current_admin.email %></span>
                </div>
                <div class="flex flex-col gap-1">
                  <%= link_to settings_path, class: "w-full text-left px-3.5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-lg cursor-pointer transition-colors flex items-center gap-2.5" do %>
                    <svg class="w-4 h-4 flex-shrink-0 text-slate-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.43l-1.003.828c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827a1.125 1.125 0 0 1 .26 1.43l-1.297 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.43l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                    Account Settings
                  <% end %>
                  <% if current_admin.superuser? %>
                    <%= button_to purge_stale_repositories_path, method: :post, class: "w-full text-left px-3.5 py-2.5 text-sm font-semibold text-rose-600 hover:bg-rose-50 rounded-lg cursor-pointer transition-colors flex items-center gap-2.5 border-0 bg-transparent" do %>
                      <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                      </svg>
                      GC Stale Signups
                    <% end %>
                  <% end %>
                  <%= button_to destroy_admin_session_path, method: :delete, class: "w-full text-left px-3.5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#ef4444] rounded-lg cursor-pointer transition-colors flex items-center gap-2.5 border-0 bg-transparent" do %>
                    <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
                    </svg>
                    Sign Out
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </nav>
      </header>
    <% end %>

    <main class="flex-1 w-full max-w-7xl mx-auto px-6 py-8 flex flex-col gap-8">
      <%= yield %>
    </main>

    <footer class="border-t border-slate-200 py-6 text-center text-xs text-slate-600 bg-white mt-auto">
      <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
        <span>© 2026 Packablock Inc. All rights reserved.</span>
        <span class="font-mono text-slate-600">Registry Web Platform v<%= app_version %><%= " (Dev)" if dev_instance? %></span>
      </div>
    </footer>

    <% if admin_signed_in? %>
      <!-- Install pkablk Modal -->
      <div id="install-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
        <!-- Backdrop -->
        <div id="install-modal-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs transition-opacity duration-200 opacity-0"></div>
        
        <!-- Modal Content Wrapper -->
        <div id="install-modal-content" class="relative bg-white rounded-xl border border-slate-200 shadow-2xl p-6 w-full max-w-lg transform scale-95 opacity-0 transition-all duration-200 z-10">
          <div class="flex justify-between items-center border-b border-slate-150 pb-3.5 mb-4">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              Install pkablk CLI
            </h3>
            <button id="close-install-modal" class="text-slate-600 hover:text-slate-800 p-1.5 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer flex items-center justify-center" aria-label="Close modal">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div class="flex flex-col gap-5">
            <!-- 1. NPM / Bun Package Install -->
            <div class="flex flex-col gap-2">
              <span class="text-xs font-bold text-slate-600 uppercase tracking-wider">Package Manager Install</span>
              
              <!-- Bun Option -->
              <div class="flex flex-col gap-1.5">
                <span class="text-[10px] font-semibold text-slate-600">Using Bun (Recommended)</span>
                <div class="bg-slate-950 text-slate-100 font-mono text-xs p-3 rounded-lg border border-slate-800 flex justify-between items-center">
                  <span class="truncate pr-4">bun install -g packablock-client</span>
                  <button onclick="navigator.clipboard.writeText('bun install -g packablock-client').then(() => {
                    const original = this.innerHTML;
                    this.innerHTML = '<span class=\'text-emerald-400 font-bold text-[9px] px-1 py-0.2 bg-emerald-950 border border-emerald-900 rounded\'>✓</span>';
                    setTimeout(() => { this.innerHTML = original; }, 1500);
                  })" class="text-slate-400 hover:text-white p-1 rounded hover:bg-slate-800 transition-colors cursor-pointer" title="Copy to clipboard">
                    <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v8.25A2.25 2.25 0 0 0 6 16.5h2.25m7.5-7.5a2.25 2.25 0 0 1 2.25 2.25v8.25a2.25 2.25 0 0 1-2.25 2.25H11.25a2.25 2.25 0 0 1-2.25-2.25V11.25a2.25 2.25 0 0 1 2.25-2.25H15Z" />
                    </svg>
                  </button>
                </div>
              </div>

              <!-- NPM Option -->
              <div class="flex flex-col gap-1.5 mt-1">
                <span class="text-[10px] font-semibold text-slate-600">Using NPM</span>
                <div class="bg-slate-950 text-slate-100 font-mono text-xs p-3 rounded-lg border border-slate-800 flex justify-between items-center">
                  <span class="truncate pr-4">npm install -g packablock-client</span>
                  <button onclick="navigator.clipboard.writeText('npm install -g packablock-client').then(() => {
                    const original = this.innerHTML;
                    this.innerHTML = '<span class=\'text-emerald-400 font-bold text-[9px] px-1 py-0.2 bg-emerald-950 border border-emerald-900 rounded\'>✓</span>';
                    setTimeout(() => { this.innerHTML = original; }, 1500);
                  })" class="text-slate-400 hover:text-white p-1 rounded hover:bg-slate-800 transition-colors cursor-pointer" title="Copy to clipboard">
                    <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v8.25A2.25 2.25 0 0 0 6 16.5h2.25m7.5-7.5a2.25 2.25 0 0 1 2.25 2.25v8.25a2.25 2.25 0 0 1-2.25 2.25H11.25a2.25 2.25 0 0 1-2.25-2.25V11.25a2.25 2.25 0 0 1 2.25-2.25H15Z" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <!-- 2. Shell Script / Curl Script -->
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-slate-600 uppercase tracking-wider">Direct Shell Run</span>
                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded border border-amber-200 bg-amber-50 text-amber-600 uppercase tracking-wider">Coming Soon</span>
              </div>
              <div class="bg-slate-900/60 text-slate-300 font-mono text-xs p-3 rounded-lg border border-slate-200/60 flex justify-between items-center opacity-75">
                <span class="truncate pr-4">curl -fsSL https://packablock.com/install.sh | sh</span>
                <button onclick="navigator.clipboard.writeText('curl -fsSL https://packablock.com/install.sh | sh').then(() => {
                  const original = this.innerHTML;
                  this.innerHTML = '<span class=\'text-emerald-400 font-bold text-[9px] px-1 py-0.2 bg-emerald-950 border border-emerald-900 rounded\'>✓</span>';
                  setTimeout(() => { this.innerHTML = original; }, 1500);
                })" class="text-slate-400 hover:text-slate-600 p-1 rounded hover:bg-slate-100 transition-colors cursor-pointer" title="Copy to clipboard">
                  <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v8.25A2.25 2.25 0 0 0 6 16.5h2.25m7.5-7.5a2.25 2.25 0 0 1 2.25 2.25v8.25a2.25 2.25 0 0 1-2.25 2.25H11.25a2.25 2.25 0 0 1-2.25-2.25V11.25a2.25 2.25 0 0 1 2.25-2.25H15Z" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- 3. GitHub Link -->
            <div class="border-t border-slate-150 pt-4 flex justify-between items-center">
              <span class="text-xs text-slate-600">Open source on GitHub:</span>
              <a href="https://github.com/Packablock/packablock-client" target="_blank" class="flex items-center gap-1.5 text-xs font-bold text-slate-700 hover:text-slate-900 transition-colors hover:underline">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                </svg>
                Packablock Client Repo
              </a>
            </div>
          </div>
        </div>
      </div>

      <script>
        (function() {
          let closeNotification = null;
          let closeAdmin = null;

          function initNotificationDropdown() {
            const trigger = document.getElementById("notification-trigger");
            const panel = document.getElementById("notification-panel");

            if (!trigger || !panel) return;

            // Clone to strip existing event listeners and avoid duplicate bindings
            const newTrigger = trigger.cloneNode(true);
            trigger.parentNode.replaceChild(newTrigger, trigger);

            const arrow = newTrigger.querySelector("#notification-arrow-icon");
            let autoCollapseTimeout = null;

            function openPanel() {
              if (closeAdmin) closeAdmin();

              panel.classList.remove("hidden");
              setTimeout(() => {
                panel.classList.remove("scale-95", "opacity-0");
                panel.classList.add("scale-100", "opacity-100");
              }, 10);
              if (arrow) arrow.classList.add("rotate-180");

              // Mark all alerts seen by fading and hiding the notification dot
              const dot = document.getElementById("notification-dot");
              if (dot) {
                dot.classList.add("opacity-0");
                setTimeout(() => dot.classList.add("hidden"), 300);
              }

              // Update alert items to seen state
              const badges = panel.querySelectorAll(".alert-seen-badge");
              badges.forEach(badge => {
                badge.textContent = "Seen";
                badge.className = "alert-seen-badge text-[8px] font-bold px-1.5 py-0.2 rounded bg-slate-100 text-slate-400 uppercase tracking-wider";
              });
            }

            function closePanel() {
              if (autoCollapseTimeout) {
                clearTimeout(autoCollapseTimeout);
                autoCollapseTimeout = null;
              }
              panel.classList.remove("scale-100", "opacity-100");
              panel.classList.add("scale-95", "opacity-0");
              if (arrow) arrow.classList.remove("rotate-180");
              setTimeout(() => {
                panel.classList.add("hidden");
              }, 200);
            }

            closeNotification = closePanel;

            function togglePanel(e) {
              if (e) e.stopPropagation();
              const isHidden = panel.classList.contains("hidden");
              if (isHidden) {
                openPanel();
              } else {
                closePanel();
              }
            }

            newTrigger.addEventListener("click", togglePanel);

            // Cancel auto-collapse if user clicks inside the panel
            panel.addEventListener("click", (e) => {
              e.stopPropagation();
              if (autoCollapseTimeout) {
                clearTimeout(autoCollapseTimeout);
                autoCollapseTimeout = null;
              }
            });

            // Cancel auto-collapse if focus moves inside the panel
            panel.addEventListener("focusin", () => {
              if (autoCollapseTimeout) {
                clearTimeout(autoCollapseTimeout);
                autoCollapseTimeout = null;
              }
            });

            // Auto-expand if there are active alerts, then auto-collapse after 15 seconds
            const hasAlerts = <%= (notice.present? || alert.present?) ? "true" : "false" %>;
            if (hasAlerts) {
              openPanel();
              autoCollapseTimeout = setTimeout(() => {
                closePanel();
              }, 15000);
            }
          }

          function initAdminDropdown() {
            const trigger = document.getElementById("admin-trigger");
            const panel = document.getElementById("admin-panel");

            if (!trigger || !panel) return;

            // Clone to strip existing event listeners and avoid duplicate bindings
            const newTrigger = trigger.cloneNode(true);
            trigger.parentNode.replaceChild(newTrigger, trigger);

            const arrow = newTrigger.querySelector("#admin-arrow-icon");

            function openPanel() {
              if (closeNotification) closeNotification();

              panel.classList.remove("hidden");
              setTimeout(() => {
                panel.classList.remove("scale-95", "opacity-0");
                panel.classList.add("scale-100", "opacity-100");
              }, 10);
              if (arrow) arrow.classList.add("rotate-180");
            }

            function closePanel() {
              panel.classList.remove("scale-100", "opacity-100");
              panel.classList.add("scale-95", "opacity-0");
              if (arrow) arrow.classList.remove("rotate-180");
              setTimeout(() => {
                panel.classList.add("hidden");
              }, 200);
            }

            closeAdmin = closePanel;

            function togglePanel(e) {
              if (e) e.stopPropagation();
              const isHidden = panel.classList.contains("hidden");
              if (isHidden) {
                openPanel();
              } else {
                closePanel();
              }
            }

            newTrigger.addEventListener("click", togglePanel);

            panel.addEventListener("click", (e) => {
              e.stopPropagation();
            });
          }

          function initInstallModal() {
            const modal = document.getElementById("install-modal");
            if (!modal) return;

            const triggers = [
              document.getElementById("nav-install-trigger"),
              document.getElementById("open-install-modal")
            ].filter(Boolean);

            const backdrop = document.getElementById("install-modal-backdrop");
            const content = document.getElementById("install-modal-content");
            const closeBtn = document.getElementById("close-install-modal");

            if (!backdrop || !content || !closeBtn) return;

            function openModal() {
              modal.classList.remove("hidden");
              document.body.classList.add("overflow-hidden");
              setTimeout(() => {
                backdrop.classList.remove("opacity-0");
                backdrop.classList.add("opacity-100");
                content.classList.remove("scale-95", "opacity-0");
                content.classList.add("scale-100", "opacity-100");
              }, 10);
            }

            function closeModal() {
              backdrop.classList.remove("opacity-100");
              backdrop.classList.add("opacity-0");
              content.classList.remove("scale-100", "opacity-100");
              content.classList.add("scale-95", "opacity-0");
              document.body.classList.remove("overflow-hidden");
              setTimeout(() => {
                modal.classList.add("hidden");
              }, 200);
            }

            triggers.forEach(trigger => {
              const newTrigger = trigger.cloneNode(true);
              trigger.parentNode.replaceChild(newTrigger, trigger);
              newTrigger.addEventListener("click", (e) => {
                e.preventDefault();
                openModal();
              });
            });

            closeBtn.addEventListener("click", closeModal);
            backdrop.addEventListener("click", closeModal);

            // Escape key listener to close modal
            if (window._cleanupInstallModalKeydown) {
              document.removeEventListener("keydown", window._cleanupInstallModalKeydown);
            }
            const handleKeyDown = (e) => {
              if (e.key === "Escape" && !modal.classList.contains("hidden")) {
                closeModal();
              }
            };
            window._cleanupInstallModalKeydown = handleKeyDown;
            document.addEventListener("keydown", handleKeyDown);
          }

          function initAllDropdowns() {
            initNotificationDropdown();
            initAdminDropdown();
            initInstallModal();

            // Set up a single document-level outside click handler
            if (window._cleanupDropdownClick) {
              document.removeEventListener("click", window._cleanupDropdownClick);
            }

            const handleOutsideClick = (e) => {
              const notificationTrigger = document.getElementById("notification-trigger");
              const notificationPanel = document.getElementById("notification-panel");
              const adminTrigger = document.getElementById("admin-trigger");
              const adminPanel = document.getElementById("admin-panel");

              if (notificationPanel && !notificationPanel.classList.contains("hidden") &&
                  !notificationPanel.contains(e.target) &&
                  notificationTrigger && !notificationTrigger.contains(e.target)) {
                if (closeNotification) closeNotification();
              }

              if (adminPanel && !adminPanel.classList.contains("hidden") &&
                  !adminPanel.contains(e.target) &&
                  adminTrigger && !adminTrigger.contains(e.target)) {
                if (closeAdmin) closeAdmin();
              }
            };

            window._cleanupDropdownClick = handleOutsideClick;
            document.addEventListener("click", handleOutsideClick);
          }

          // Listen to DOMContentLoaded and turbo:load
          document.addEventListener("DOMContentLoaded", initAllDropdowns);
          document.addEventListener("turbo:load", initAllDropdowns);

          // Run immediately in case the DOM is already ready
          if (document.readyState === "interactive" || document.readyState === "complete") {
            initAllDropdowns();
          }
        })();
      </script>
    <% end %>
  </body>
</html>
