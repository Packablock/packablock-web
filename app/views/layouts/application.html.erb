<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Packablock Web" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Packablock Web">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=IBM+Plex+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=block" rel="stylesheet">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans antialiased">
    <% if admin_signed_in? %>
      <header class="border-b border-slate-200 bg-white/80 backdrop-blur-md sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <a href="<%= dashboard_path %>" class="flex items-center gap-2.5 font-black text-lg tracking-wider text-slate-900 uppercase hover:opacity-90">
          <svg class="w-6 h-6 text-[#10b981]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" fill="none" stroke="none" role="img" aria-label="Packablock registry mark">
            <line x1="40" y1="36" x2="40" y2="84" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
            <circle cx="40" cy="42" r="6" fill="currentColor"/><circle cx="40" cy="60" r="6" fill="currentColor"/><circle cx="40" cy="78" r="6" fill="currentColor"/>
            <rect x="50" y="36.5" width="42" height="11" rx="4" fill="currentColor"/>
            <rect x="50" y="54.5" width="28" height="11" rx="4" fill="currentColor"/>
            <rect x="50" y="72.5" width="36" height="11" rx="4" fill="currentColor"/>
          </svg>
          Packablock <span class="font-mono text-[#10b981] text-sm font-medium">[<%= org_or_email_for(current_admin) %>]</span>
        </a>
        <nav class="flex items-center gap-6">
          <%= link_to "Dashboard", dashboard_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors" %>
          <%= link_to "Create Project", new_project_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors" %>
          
          <div class="h-4 w-px bg-slate-200"></div>
          
          <div class="flex items-center gap-2">
            <!-- Notification Dropdown -->
            <div class="relative flex items-center gap-1 mr-2" id="notification-dropdown-container">
              <!-- Notification Trigger Button -->
              <button id="notification-trigger" class="relative p-1.5 text-slate-400 hover:text-slate-600 rounded-full hover:bg-slate-100 transition-all flex items-center justify-center focus:outline-none" aria-label="Notifications">
                <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a9.049 9.049 0 0 1-5.12 0m-.075-12.648a3.001 3.001 0 1 1 5.96 0M12 18.75V16.5m-9-4.5h18M5.25 12h13.5A2.25 2.25 0 0 0 21 9.75V9A6 6 0 0 0 9 9v.75A2.25 2.25 0 0 0 11.25 12Z" />
                </svg>
                <% if notice.present? || alert.present? %>
                  <span class="absolute top-1 right-1 flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                  </span>
                <% end %>
              </button>

              <!-- Expand Toggle Button -->
              <button id="notification-expand-toggle" class="p-1 text-slate-400 hover:text-slate-600 rounded hover:bg-slate-100 transition-colors focus:outline-none" aria-label="Toggle notifications panel">
                <svg class="w-3.5 h-3.5 transition-transform duration-200" id="notification-arrow-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </button>
              
              <!-- Redesigned Dropdown Notification Panel -->
              <div id="notification-panel" class="hidden absolute right-0 top-full mt-3 w-80 rounded-xl border border-slate-200 bg-white/95 backdrop-blur-md p-4 shadow-xl ring-1 ring-black/5 z-50 transition-all duration-200 origin-top-right transform scale-95 opacity-0">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">System Alerts</span>
                  <% if notice.present? || alert.present? %>
                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-rose-50 border border-rose-100 text-rose-600 uppercase">Active</span>
                  <% end %>
                </div>
                
                <div class="flex flex-col gap-2.5 max-h-60 overflow-y-auto">
                  <% if notice.present? %>
                    <div class="p-3 rounded-lg bg-emerald-50/80 border border-emerald-100/50 text-emerald-800 text-xs font-medium flex gap-2.5 shadow-sm">
                      <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-[10px]">✓</div>
                      <div class="flex-1 leading-normal"><%= notice %></div>
                    </div>
                  <% end %>
                  
                  <% if alert.present? %>
                    <div class="p-3 rounded-lg bg-rose-50/80 border border-rose-100/50 text-rose-800 text-xs font-medium flex gap-2.5 shadow-sm">
                      <div class="flex-shrink-0 w-5 h-5 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-[10px]">!</div>
                      <div class="flex-1 leading-normal"><%= alert %></div>
                    </div>
                  <% end %>
                  
                  <% if !notice.present? && !alert.present? %>
                    <div class="py-6 text-center text-slate-400 flex flex-col items-center justify-center gap-2">
                      <svg class="w-7 h-7 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                      </svg>
                      <span class="text-xs">No active alerts</span>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <% if current_admin.superuser? %>
              <span class="text-xs font-semibold px-2 py-0.5 rounded border border-[#8b5cf6]/30 bg-[#8b5cf6]/10 text-[#8b5cf6] uppercase">Root Admin</span>
            <% else %>
              <span class="text-xs font-semibold px-2 py-0.5 rounded border border-slate-200 bg-slate-100 text-slate-700 uppercase"><%= current_admin.email.split('@').last.split('.').first.capitalize %> Org</span>
            <% end %>
            <%= button_to "Sign Out", destroy_admin_session_path, method: :delete, class: "text-xs font-semibold text-[#ef4444] hover:underline bg-transparent border-0 cursor-pointer" %>
          </div>
        </nav>
      </header>
    <% end %>

    <main class="flex-1 w-full max-w-7xl mx-auto px-6 py-8 flex flex-col gap-8">
      <%= yield %>
    </main>

    <footer class="border-t border-slate-200 py-6 text-center text-xs text-slate-500 bg-white mt-auto">
      <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
        <span>© 2026 Packablock Inc. All rights reserved.</span>
        <span class="font-mono text-slate-600">Registry Web Platform v1.0.0</span>
      </div>
    </footer>

    <% if admin_signed_in? %>
      <script>
        document.addEventListener("turbo:load", () => {
          const trigger = document.getElementById("notification-trigger");
          const toggleBtn = document.getElementById("notification-expand-toggle");
          const panel = document.getElementById("notification-panel");
          const arrow = document.getElementById("notification-arrow-icon");

          if (!trigger || !panel) return;

          function togglePanel() {
            const isHidden = panel.classList.contains("hidden");
            if (isHidden) {
              panel.classList.remove("hidden");
              setTimeout(() => {
                panel.classList.remove("scale-95", "opacity-0");
                panel.classList.add("scale-100", "opacity-100");
              }, 10);
              if (arrow) arrow.classList.add("rotate-180");
            } else {
              panel.classList.remove("scale-100", "opacity-100");
              panel.classList.add("scale-95", "opacity-0");
              if (arrow) arrow.classList.remove("rotate-180");
              setTimeout(() => {
                panel.classList.add("hidden");
              }, 200);
            }
          }

          trigger.addEventListener("click", (e) => {
            e.stopPropagation();
            togglePanel();
          });

          if (toggleBtn) {
            toggleBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              togglePanel();
            });
          }

          document.addEventListener("click", (e) => {
            if (!panel.classList.contains("hidden") && !panel.contains(e.target) && e.target !== trigger && e.target !== toggleBtn) {
              panel.classList.remove("scale-100", "opacity-100");
              panel.classList.add("scale-95", "opacity-0");
              if (arrow) arrow.classList.remove("rotate-180");
              setTimeout(() => {
                panel.classList.add("hidden");
              }, 200);
            }
          });
        });
      </script>
    <% end %>
  </body>
</html>
