<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Packablock Web" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Packablock Web">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=IBM+Plex+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=block" rel="stylesheet">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans antialiased">
    <% if admin_signed_in? %>
      <header class="border-b border-slate-200 bg-white/80 backdrop-blur-md sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <a href="<%= dashboard_path %>" class="flex items-center gap-2.5 font-black text-lg tracking-wider text-slate-900 uppercase hover:opacity-90">
          <svg class="w-6 h-6 text-[#10b981]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" fill="none" stroke="none" role="img" aria-label="Packablock registry mark">
            <line x1="40" y1="36" x2="40" y2="84" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
            <circle cx="40" cy="42" r="6" fill="currentColor"/><circle cx="40" cy="60" r="6" fill="currentColor"/><circle cx="40" cy="78" r="6" fill="currentColor"/>
            <rect x="50" y="36.5" width="42" height="11" rx="4" fill="currentColor"/>
            <rect x="50" y="54.5" width="28" height="11" rx="4" fill="currentColor"/>
            <rect x="50" y="72.5" width="36" height="11" rx="4" fill="currentColor"/>
          </svg>
          Packablock <span class="font-mono text-[#10b981] text-sm font-medium">[registry-web]</span>
        </a>
        <nav class="flex items-center gap-6">
          <%= link_to "Dashboard", dashboard_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors" %>
          <%= link_to "Create Project", new_project_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors" %>
          
          <div class="h-4 w-px bg-slate-200"></div>
          
          <div class="flex items-center gap-2">
            <% if current_admin.superuser? %>
              <span class="text-xs font-semibold px-2 py-0.5 rounded border border-[#8b5cf6]/30 bg-[#8b5cf6]/10 text-[#8b5cf6] uppercase">Root Admin</span>
            <% else %>
              <span class="text-xs font-semibold px-2 py-0.5 rounded border border-slate-200 bg-slate-100 text-slate-700 uppercase"><%= current_admin.email.split('@').last.split('.').first.capitalize %> Org</span>
            <% end %>
            <%= button_to "Sign Out", destroy_admin_session_path, method: :delete, class: "text-xs font-semibold text-[#ef4444] hover:underline bg-transparent border-0 cursor-pointer" %>
          </div>
        </nav>
      </header>
    <% end %>

    <% if notice.present? || alert.present? %>
      <div class="max-w-7xl mx-auto w-full px-6 mt-4">
        <% if notice.present? %>
          <div class="p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium flex items-center gap-2 shadow-sm">
            <span class="text-lg">✓</span> <%= notice %>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="p-4 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium flex items-center gap-2 shadow-sm">
            <span class="text-lg">⚠</span> <%= alert %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="flex-1 w-full max-w-7xl mx-auto px-6 py-8 flex flex-col gap-8">
      <%= yield %>
    </main>

    <footer class="border-t border-slate-200 py-6 text-center text-xs text-slate-500 bg-white mt-auto">
      <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
        <span>© 2026 Packablock Inc. All rights reserved.</span>
        <span class="font-mono text-slate-600">Registry Web Platform v1.0.0</span>
      </div>
    </footer>
  </body>
</html>
