<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Packablock Web" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Packablock Web">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-[#0b0f19] text-[#f9fafb] min-h-screen flex flex-col font-sans antialiased">
    <% if admin_signed_in? %>
      <header class="border-b border-[#1f2937] bg-[#0b0f19]/80 backdrop-blur-md sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <a href="<%= dashboard_path %>" class="flex items-center gap-2 font-black text-lg tracking-wider text-white uppercase hover:opacity-90">
          <span class="w-2.5 h-2.5 rounded-full bg-[#10b981] inline-block animate-pulse"></span>
          Packablock <span class="font-mono text-[#10b981] text-sm font-medium">[registry-web]</span>
        </a>
        <nav class="flex items-center gap-6">
          <%= link_to "Dashboard", dashboard_path, class: "text-sm font-semibold text-gray-400 hover:text-white transition-colors" %>
          <%= link_to "Create Project", new_project_path, class: "text-sm font-semibold text-gray-400 hover:text-white transition-colors" %>
          
          <div class="h-4 w-px bg-[#1f2937]"></div>
          
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold px-2 py-0.5 rounded border border-[#8b5cf6]/30 bg-[#8b5cf6]/10 text-[#8b5cf6] uppercase">Root Admin</span>
            <%= button_to "Sign Out", destroy_admin_session_path, method: :delete, class: "text-xs font-semibold text-[#ef4444] hover:underline bg-transparent border-0 cursor-pointer" %>
          </div>
        </nav>
      </header>
    <% end %>

    <% if notice.present? || alert.present? %>
      <div class="max-w-7xl mx-auto w-full px-6 mt-4">
        <% if notice.present? %>
          <div class="p-4 rounded-lg bg-[#10b981]/10 border border-[#10b981]/20 text-[#10b981] text-sm font-medium flex items-center gap-2 shadow-lg shadow-[#10b981]/5">
            <span class="text-lg">✓</span> <%= notice %>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="p-4 rounded-lg bg-[#ef4444]/10 border border-[#ef4444]/20 text-[#ef4444] text-sm font-medium flex items-center gap-2 shadow-lg shadow-[#ef4444]/5">
            <span class="text-lg">⚠</span> <%= alert %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="flex-1 w-full max-w-7xl mx-auto px-6 py-8 flex flex-col gap-8">
      <%= yield %>
    </main>

    <footer class="border-t border-[#1f2937] py-6 text-center text-xs text-gray-500 bg-[#111827]/30 mt-auto">
      <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
        <span>© 2026 Packablock Inc. All rights reserved.</span>
        <span class="font-mono text-gray-400">Registry Web Platform v1.0.0</span>
      </div>
    </footer>
  </body>
</html>
