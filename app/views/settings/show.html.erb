<div class="flex flex-col gap-8 w-full">
  <!-- Title / Top Action Row -->
  <div class="flex justify-between items-center flex-wrap gap-4">
    <div class="flex items-center gap-3">
      <div class="p-2 bg-slate-100 rounded-xl text-slate-700 border border-slate-200 shadow-sm flex items-center justify-center">
        <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.43l-1.003.828c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827a1.125 1.125 0 0 1 .26 1.43l-1.297 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.43l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
      </div>
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Account Settings</h1>
        <p class="text-sm text-slate-500">Manage your administrative credentials, review project scopes, and monitor registry health.</p>
      </div>
    </div>
  </div>

  <!-- Layout Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Settings Forms (Col Span 7) -->
    <div class="lg:col-span-7 flex flex-col gap-8">
      
      <!-- Security Form Card -->
      <div class="border border-slate-200 rounded-xl bg-white shadow-sm p-6 flex flex-col gap-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Security & Credentials</h2>
          <p class="text-xs text-slate-500">Update your email address or account access token / password.</p>
        </div>

        <%= form_with(model: @admin, url: settings_path, method: :patch, class: "flex flex-col gap-5") do |form| %>
          <% if @admin.errors.any? %>
            <div class="p-4 rounded-lg bg-rose-50 border border-rose-100 text-rose-800 text-xs font-semibold">
              <h3 class="font-bold mb-1"><%= pluralize(@admin.errors.count, "error") %> prevented saving:</h3>
              <ul class="list-disc pl-4 mt-1.5 font-normal flex flex-col gap-0.5">
                <% @admin.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- Email Field -->
          <div class="flex flex-col gap-1.5">
            <%= form.label :email, "Email Address", class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
            <%= form.email_field :email, class: "w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-emerald-500 transition-colors placeholder:text-slate-400" %>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- New Password Field -->
            <div class="flex flex-col gap-1.5">
              <%= form.label :password, "New Access Token / Password", class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
              <%= form.password_field :password, autocomplete: "new-password", placeholder: "Leave blank to keep current", class: "w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-emerald-500 transition-colors placeholder:text-slate-400" %>
            </div>

            <!-- Password Confirmation Field -->
            <div class="flex flex-col gap-1.5">
              <%= form.label :password_confirmation, "Confirm New Password", class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
              <%= form.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Leave blank to keep current", class: "w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-emerald-500 transition-colors placeholder:text-slate-400" %>
            </div>
          </div>

          <div class="h-px bg-slate-100 my-1"></div>

          <!-- Current Password Verification Field -->
          <div class="flex flex-col gap-1.5">
            <div class="flex justify-between items-center">
              <%= form.label :current_password, "Current Token / Password", class: "text-xs font-bold text-slate-400 uppercase tracking-wider" %>
              <span class="text-[10px] font-bold text-rose-500 uppercase tracking-wider">Required for Changes</span>
            </div>
            <%= form.password_field :current_password, autocomplete: "current-password", placeholder: "Enter current credentials to verify", class: "w-full bg-slate-50/50 border border-slate-200 rounded-lg px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-emerald-500 transition-colors placeholder:text-slate-400" %>
          </div>

          <!-- Form Submit & Action -->
          <div class="flex gap-3 mt-2">
            <%= form.submit "Update Credentials", class: "px-5 py-2.5 rounded-lg bg-emerald-600 text-white font-bold text-xs cursor-pointer hover:bg-emerald-700 hover:shadow-md transition-all uppercase tracking-wider" %>
            <%= link_to "Cancel", dashboard_path, class: "px-5 py-2.5 rounded-lg border border-slate-200 text-slate-500 hover:text-slate-900 text-xs font-bold uppercase tracking-wider flex items-center justify-center transition-colors" %>
          </div>
        <% end %>
      </div>

    </div>

    <!-- Right Column: Meta & Info Diagnostics (Col Span 5) -->
    <div class="lg:col-span-5 flex flex-col gap-8">
      
      <!-- Account Profile / Metadata Info Card -->
      <div class="border border-slate-200 rounded-xl bg-white shadow-sm p-6 flex flex-col gap-4.5">
        <div>
          <h2 class="text-lg font-bold text-slate-900">User Profile</h2>
          <p class="text-xs text-slate-500">Classification details and privileges bounds.</p>
        </div>

        <div class="flex flex-col gap-3.5 bg-slate-50 rounded-xl p-4.5 border border-slate-200/60">
          <div class="flex justify-between items-center">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Account Role</span>
            <% if @admin.superuser? %>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border border-blue-200 bg-blue-50 text-blue-700 uppercase tracking-wider">Superuser</span>
            <% else %>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border border-slate-350 bg-slate-200 text-slate-700 uppercase tracking-wider">Standard Admin</span>
            <% end %>
          </div>

          <div class="flex justify-between items-start">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Email</span>
            <span class="text-xs font-semibold text-slate-700 font-mono select-all truncate max-w-[200px]" title="<%= @admin.email %>"><%= @admin.email %></span>
          </div>

          <div class="h-px bg-slate-200/70 my-0.5"></div>

          <div class="flex flex-col gap-1.5 text-xs text-slate-600">
            <span class="font-bold text-slate-700">Role Boundaries:</span>
            <% if @admin.superuser? %>
              <p class="leading-relaxed">Root superuser account. You have global, unrestricted visibility into all organization projects, linked repository ledgers, and can force system-wide diagnostics/garbage collection.</p>
            <% else %>
              <p class="leading-relaxed">Standard administrator account. Scope is isolated to your owned projects and mapped repositories. Global administration and GC tools are restricted.</p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Trust Registry Endpoint Integrations Diagnostics Card -->
      <div class="border border-slate-200 rounded-xl bg-white shadow-sm p-6 flex flex-col gap-4.5">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Registry Connection</h2>
          <p class="text-xs text-slate-500">Connection statistics to the cryptographic trust registry.</p>
        </div>

        <div class="flex flex-col gap-3.5 bg-slate-50 rounded-xl p-4.5 border border-slate-200/60 font-mono text-[11px] text-slate-600">
          <div class="flex justify-between items-center font-sans">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">API Connection</span>
            <% if @registry_online %>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-250 bg-emerald-50 text-emerald-700 uppercase tracking-wider">Online</span>
            <% else %>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border border-rose-250 bg-rose-50 text-rose-700 uppercase tracking-wider">Offline</span>
            <% end %>
          </div>

          <div class="flex justify-between items-start gap-4">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider font-sans">Endpoint URL</span>
            <span class="text-right text-slate-700 break-all select-all font-semibold" title="<%= @registry_url %>"><%= @registry_url %></span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider font-sans">Internal Token</span>
            <span class="text-slate-500 font-semibold select-none"><%= @registry_token_masked %></span>
          </div>

          <div class="h-px bg-slate-200/70 my-0.5"></div>

          <div class="grid grid-cols-2 gap-y-2 text-xs font-sans">
            <div class="text-slate-400 font-semibold">Total Projects (Registry):</div>
            <div class="font-bold text-slate-800 text-right"><%= @system_status["projectsCount"] %></div>
            <div class="text-slate-400 font-semibold">Total Repos (Registry):</div>
            <div class="font-bold text-slate-800 text-right"><%= @system_status["reposCount"] %></div>
            <div class="text-slate-400 font-semibold">Registry State:</div>
            <div class="font-bold text-slate-800 text-right"><%= @system_status["status"] %></div>
          </div>

          <% if @admin.superuser? %>
            <div class="h-px bg-slate-200/70 my-0.5"></div>
            <!-- GC button in diagnostics panel -->
            <div class="flex flex-col gap-2 font-sans">
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">System Administration</span>
              <%= button_to purge_stale_repositories_path, method: :post, class: "w-full py-2 px-3 text-xs font-bold border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white rounded-lg cursor-pointer transition-all flex items-center justify-center gap-2" do %>
                <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
                Force GC on Stale Signups
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Scoped Projects Inventory Card -->
      <div class="border border-slate-200 rounded-xl bg-white shadow-sm p-6 flex flex-col gap-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Your Project Scopes</h2>
          <p class="text-xs text-slate-500">Logical project containers assigned to your profile.</p>
        </div>

        <div class="flex flex-col border border-slate-200 rounded-xl divide-y divide-slate-150 overflow-hidden bg-white max-h-60 overflow-y-auto">
          <% if @projects.empty? %>
            <div class="p-6 text-center text-xs text-slate-400 italic">No assigned projects.</div>
          <% else %>
            <% @projects.each do |project| %>
              <div class="flex justify-between items-center px-4 py-3 hover:bg-slate-50/50 transition-colors">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="text-sm">📂</span>
                  <%= link_to project.name, project_path(project), class: "text-xs font-bold text-slate-800 hover:text-emerald-600 hover:underline truncate" %>
                </div>
                <span class="text-[10px] font-semibold text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full flex-shrink-0">
                  <%= project.project_repositories.count %> repositories
                </span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
