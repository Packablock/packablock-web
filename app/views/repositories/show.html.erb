<style>
  #chain-minimap::-webkit-scrollbar,
  #chain-minimap > div::-webkit-scrollbar,
  #chain-timeline::-webkit-scrollbar {
    display: none;
  }
  #chain-minimap,
  #chain-minimap > div,
  #chain-timeline {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
<div class="flex flex-col gap-8 w-full">
  <!-- Title / Breadcrumbs -->
  <div class="flex justify-between items-start flex-wrap gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">
        <%= link_to "Dashboard", dashboard_path, class: "hover:text-slate-900" %>
        <% if @project %>
          <span>/</span>
          <%= link_to "Projects", projects_path, class: "hover:text-slate-900" %>
          <span>/</span>
          <%= link_to @project.name, project_path(@project), class: "hover:text-slate-900" %>
        <% end %>
        <span>/</span>
        <span class="text-slate-800 font-mono"><%= @repository["owner"] %>/<%= @repository["repo"] %></span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 font-mono"><%= @repository["owner"] %>/<%= @repository["repo"] %></h1>
      <p class="text-sm text-slate-500">Cryptographic audit log chain tree & pinned keys.</p>
    </div>
    
    <div class="flex gap-3">
      <%= link_to "Back to Console", dashboard_path, class: "px-4 py-2 text-xs font-bold rounded-lg border border-slate-200 text-slate-500 hover:text-slate-900 hover:border-slate-400 bg-white transition-colors uppercase tracking-wider flex items-center justify-center" %>
    </div>
  </div>

  <!-- Realtime credential audit -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="border border-slate-200 rounded-xl bg-white shadow-sm p-6 flex flex-col gap-6">
      <div>
        <h3 class="text-lg font-bold text-slate-900">Registry Credentials</h3>
        <p class="text-xs text-slate-500">Zero-trust push configurations and state tokens.</p>
      </div>

      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-1.5">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Active Push Token</label>
          <div class="flex gap-2">
            <input type="text" value="<%= @repository["registration_token"] %>" readonly class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-mono focus:outline-none" id="token-copy-field">
            <button onclick="copyToken()" class="px-4 py-2 text-xs font-bold rounded-lg bg-slate-100 border border-slate-200 text-slate-700 hover:bg-slate-200 cursor-pointer transition-colors">Copy</button>
          </div>
        </div>

        <div class="flex justify-between items-center text-sm border-t border-slate-100 pt-4 mt-2">
          <span class="text-xs text-slate-500">Premium Account Tier:</span>
          <% if @repository["is_premium"] == 1 %>
            <span class="text-xs font-bold px-2 py-0.5 rounded border border-violet-200 bg-violet-50 text-violet-700 uppercase">Active Premium</span>
          <% else %>
            <span class="text-xs font-bold px-2 py-0.5 rounded border border-slate-200 bg-slate-100 text-slate-700 uppercase">Standard Tier</span>
          <% end %>
        </div>
        <% if @repository["is_premium"] != 1 %>
          <p class="text-[10px] text-violet-600 italic mt-1">💡 Upstream SemVer release tracking & drift detection are locked on Standard Tier.</p>
        <% end %>

        <div class="flex gap-3 border-t border-slate-100 pt-4 mt-2">
          <%= button_to "Toggle Premium Access", toggle_premium_repository_path(@repository["id"]), method: :post, class: "flex-1 py-2.5 rounded-lg border border-violet-200 bg-violet-50 text-violet-600 font-bold text-xs cursor-pointer hover:bg-violet-600 hover:text-white transition-all uppercase tracking-wider" %>
          <%= button_to "Revoke Auth Token", revoke_repository_path(@repository["id"]), method: :post, data: { confirm: "Are you sure you want to permanently revoke this repository token?" }, class: "flex-1 py-2.5 rounded-lg border border-rose-200 bg-rose-50 text-rose-600 font-bold text-xs cursor-pointer hover:bg-rose-600 hover:text-white transition-all uppercase tracking-wider" unless @repository["registration_token"].start_with?("pb_revoked_") %>
        </div>
      </div>
    </div>

    <div class="border border-slate-200 rounded-xl bg-white shadow-sm p-6 flex flex-col gap-6">
      <div>
        <h3 class="text-lg font-bold text-slate-900">Challenge Trust Pinned Identity</h3>
        <p class="text-xs text-slate-500">Cryptographic identity pinned in registry database.</p>
      </div>

      <div class="flex flex-col gap-4">
        <div class="flex justify-between items-center text-sm">
          <span class="text-xs text-slate-500">ACME Verification Status:</span>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded border border-emerald-200 bg-emerald-50 text-emerald-700 uppercase"><%= @repository["verification_status"] || "none" %></span>
        </div>

        <div class="flex flex-col gap-1.5 border-t border-slate-100 pt-3">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Active Verification Challenge Nonce</label>
          <input type="text" value="<%= @repository["challenge_nonce"] || "N/A" %>" readonly class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-600 font-mono focus:outline-none">
        </div>

        <div class="flex flex-col gap-1.5 border-t border-slate-100 pt-3">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Pinned GPG / Sigstore Trust Anchor</label>
          <textarea readonly class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-[10px] text-slate-600 font-mono focus:outline-none h-[80px] resize-none"><%= @repository["pinned_public_key"] || "No public key pinned yet." %></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- D3 Visual Tree DAG & Node Inspector -->
  <div class="border border-slate-200 rounded-xl bg-white shadow-sm p-6 flex flex-col gap-6">
    <div class="flex justify-between items-center flex-wrap gap-4">
      <div>
        <h3 class="text-xl font-bold text-slate-900">Package History Ledger Lineage</h3>
        <p class="text-xs text-slate-500">Lineage tree representing cryptographic verification checkpoints. Click blocks to inspect metadata.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- D3 Interactive Tree (2 Cols) -->
      <div class="lg:col-span-2 border border-slate-200 rounded-lg bg-white overflow-hidden relative shadow-inner" style="height: 520px;">
        <div id="loading-overlay" class="absolute inset-0 bg-white/80 backdrop-blur-sm flex justify-center items-center text-xs font-mono text-emerald-600 z-10 animate-pulse">
          Fetching cryptographic block structure...
        </div>
        <svg id="lineage-tree" class="w-full h-full cursor-grab"></svg>
      </div>

      <!-- Node Inspector Details (1 Col) -->
      <div class="border border-slate-200 rounded-lg bg-slate-50/50 p-6 flex flex-col gap-5 shadow-sm" id="inspector-panel">
        <div>
          <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-1">Ledger Inspector</h4>
          <p class="text-[11px] text-slate-500">Click any block in the lineage tree to parse its cryptographic attributes.</p>
        </div>

        <div class="flex flex-col gap-4" id="inspector-content">
          <div class="text-center py-12 text-xs text-slate-400 italic">No block selected.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- YAML Block Payloads Panel -->
  <div class="flex flex-col gap-4" id="yaml-payloads-panel">
    <div>
      <h3 class="text-xl font-bold text-slate-900">YAML Block Payload Explorer</h3>
      <p class="text-xs text-slate-500">Shows the complete, raw cryptographically signed YAML payloads (Data and Metadata) of every block in the ledger chain.</p>
    </div>

    <div class="border border-slate-200 rounded-xl bg-white shadow-sm flex flex-col overflow-hidden" style="height: 550px;">
      <!-- Terminal Window Header (Light) -->
      <div class="bg-slate-50 border-b border-slate-200 px-4 py-3 flex justify-between items-center select-none flex-shrink-0">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
          <span class="text-xs font-mono text-slate-600 ml-2 font-bold"><%= @repository["owner"] %>/<%= @repository["repo"] %>.yaml</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">Signed Ledger Stream</span>
          <span class="text-[10px] font-bold px-1.5 py-0.5 rounded border border-emerald-200 bg-emerald-50 text-emerald-700 font-mono">SECURE</span>
        </div>
      </div>

      <!-- Scrollable Ledger Content and Minimap Container -->
      <div class="flex-1 flex flex-row overflow-hidden relative">
        <!-- Scrollable Ledger Content -->
        <div class="flex-1 overflow-y-auto bg-slate-50/50 p-6 font-mono text-xs text-slate-800 leading-relaxed shadow-inner" id="yaml-list-content">
          <div class="text-center py-12 text-xs text-slate-400 italic">Loading ledger blocks...</div>
        </div>
        <!-- Git History Styled Timeline Container -->
        <div id="chain-timeline" class="border-l border-slate-200 bg-slate-50/10 flex flex-col select-none relative overflow-y-auto flex-shrink-0" style="scrollbar-width: none; -ms-overflow-style: none; width: 140px;">
          <!-- Timeline will be injected here -->
        </div>
        <!-- Chain Minimap Container -->
        <div id="chain-minimap" class="border-l border-slate-200 bg-slate-50/30 flex flex-row select-none relative overflow-x-auto overflow-y-hidden flex-shrink-0" style="scrollbar-width: none; -ms-overflow-style: none;">
          <!-- Slices will be injected here -->
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/d3@7"></script>
<script src="https://cdn.jsdelivr.net/npm/js-yaml@4.1.0/dist/js-yaml.min.js"></script>
<script>
  function copyToken() {
    const copyText = document.getElementById("token-copy-field");
    copyText.select();
    copyText.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(copyText.value);
    alert("Token copied to clipboard!");
  }

  document.addEventListener("turbo:load", initTree);

  // Run immediately or on DOM content loaded
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initTree();
  } else {
    document.addEventListener("DOMContentLoaded", initTree);
  }

  function initTree() {
    const svg = d3.select("#lineage-tree");
    if (svg.empty()) return;

    // Prevent double-initialization
    if (svg.property("initialized")) return;
    svg.property("initialized", true);

    const treeUrl = "<%= tree_repository_path(@repository['id']) %>";
    const loading = document.getElementById("loading-overlay");
    const inspector = document.getElementById("inspector-content");

    fetch(treeUrl)
      .then(response => {
        if (!response.ok) throw new Error("Offline or registry API failed");
        return response.json();
      })
      .then(data => {
        if (loading) loading.style.display = "none";
        if (data.success && data.tree) {
          renderLineageTree(data.tree);
          renderYamlPayloadsList(data.graph ? data.graph.nodes : []);
        } else {
          showError("Registry has no package history log initialized yet.");
        }
      })
      .catch(err => {
        if (loading) loading.style.display = "none";
        showError("Unable to load package chain tree. Fastify registry may be offline.");
      });

    function showError(message) {
      svg.html("");
      inspector.innerHTML = `<div class="text-center py-12 text-xs text-slate-400 italic">Audit tree unavailable.</div>`;
      const yamlContainer = document.getElementById("yaml-list-content");
      if (yamlContainer) {
        yamlContainer.innerHTML = `<div class="text-center py-12 text-xs text-slate-400 italic">Audit logs unavailable.</div>`;
      }
      const g = svg.append("g")
        .attr("transform", "translate(40, 260)");
      g.append("text")
        .attr("fill", "#dc2626")
        .attr("font-size", "12px")
        .attr("font-family", "'IBM Plex Mono', monospace")
        .text(message);
    }

    function renderLineageTree(rootData) {
      svg.html("");
      const width = document.getElementById("lineage-tree").clientWidth || 600;
      const height = 500;

      const margin = { top: 20, right: 120, bottom: 20, left: 140 };
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      // Enable zoom and pan
      const zoomGroup = svg.append("g");
      const zoom = d3.zoom()
        .scaleExtent([0.2, 2.5])
        .on("zoom", (event) => {
          zoomGroup.attr("transform", event.transform);
        });
      svg.call(zoom);

      const rootNode = d3.hierarchy(rootData);
      
      // Calculate dynamic layout width based on chain depth to prevent horizontal squashing
      const maxDepth = rootNode.height;
      const dynamicWidth = Math.max(innerWidth, maxDepth * 110);

      // Construct layout
      const tree = d3.tree().size([innerHeight, dynamicWidth]);
      tree(rootNode);

      // Distribute nodes vertically in an alternating wave pattern to prevent overlapping text/nodes
      rootNode.descendants().forEach(d => {
        if (d.data.type === "root") {
          d.x = innerHeight / 2;
        } else {
          // Alternating offsets creates a beautiful bezier wave
          d.x = innerHeight / 2 + (d.depth % 2 === 0 ? 50 : -50);
        }
      });

      // Center view horizontally initially
      svg.call(zoom.transform, d3.zoomIdentity.translate(margin.left, margin.top));

      // Draw lines
      zoomGroup.append("g")
        .attr("fill", "none")
        .attr("stroke", "#cbd5e1")
        .attr("stroke-width", 2)
        .selectAll("path")
        .data(rootNode.links())
        .join("path")
        .attr("d", d3.linkHorizontal()
          .x(d => d.y)
          .y(d => d.x)
        );

      // Draw nodes
      const node = zoomGroup.append("g")
        .attr("stroke-linejoin", "round")
        .attr("stroke-width", 3)
        .selectAll("g")
        .data(rootNode.descendants())
        .join("g")
        .attr("transform", d => `translate(${d.y},${d.x})`)
        .on("click", (event, d) => {
          event.stopPropagation();
          inspectNode(d.data);
        })
        .style("cursor", "pointer");

      // Glowing circles
      node.append("circle")
        .attr("fill", d => {
          if (d.data.type === "root") return "#f8fafc";
          if (d.data.type === "rollover") return "#f59e0b";
          return "#10b981";
        })
        .attr("stroke", d => {
          if (d.data.type === "root") return "#64748b";
          if (d.data.type === "rollover") return "#d97706";
          return "#059669";
        })
        .attr("r", 7.5)
        .attr("class", d => d.data.type === "root" ? "" : "transition-all hover:scale-125");

      // Labels positioned above or below the node to prevent horizontal overlap
      node.append("text")
        .attr("dy", d => {
          if (d.data.type === "root") return "-1.2em";
          return d.depth % 2 === 0 ? "1.8em" : "-1.2em";
        })
        .attr("x", 0)
        .attr("text-anchor", "middle")
        .text(d => d.data.name)
        .attr("fill", "#334155")
        .attr("font-size", "10px")
        .attr("font-family", "'IBM Plex Mono', monospace")
        .clone(true).lower()
        .attr("stroke", "#ffffff")
        .attr("stroke-width", 3);

      // Auto-inspect the root node
      inspectNode(rootData);
    }

    // Node details template in inspector details
    function inspectNode(node) {
      if (node.type === "root") {
        inspector.innerHTML = `
          <div class="flex flex-col gap-4">
            <div>
              <span class="text-[9px] font-black tracking-widest text-slate-400 uppercase">Anchor Type</span>
              <div class="text-sm font-bold text-slate-900 mt-0.5">Genesis Anchor Point</div>
            </div>
            <div class="border-t border-slate-200 pt-3">
              <span class="text-[9px] font-black tracking-widest text-slate-400 uppercase">Root Hash Identifier</span>
              <div class="text-[10px] font-mono text-slate-700 mt-1 break-all bg-white p-2.5 rounded border border-slate-200">${node.id}</div>
            </div>
            <div class="text-[11px] text-slate-500 italic border-t border-slate-200 pt-3 mt-1">This node establishes the initial cryptographic trust root. All subsequent package logs anchor validation back to this key.</div>
          </div>
        `;
      } else {
        const badge = node.identityBadge ? `<span class="text-[9px] font-bold px-1.5 py-0.2 rounded border border-violet-200 bg-violet-50 text-violet-700 uppercase">${node.identityBadge}</span>` : `<span class="text-[9px] font-bold px-1.5 py-0.2 rounded border border-slate-200 bg-slate-100 text-slate-700 uppercase">Raw Push</span>`;
        
        inspector.innerHTML = `
          <div class="flex flex-col gap-4">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-[9px] font-black tracking-widest text-slate-400 uppercase">Verification Level</span>
                <div class="text-sm font-bold text-slate-900 mt-0.5">${node.name}</div>
              </div>
              ${badge}
            </div>

            <div class="border-t border-slate-200 pt-3">
              <span class="text-[9px] font-black tracking-widest text-slate-400 uppercase">Client Spec Version</span>
              <div class="text-xs font-bold text-slate-800 mt-0.5">${node.version || "1.0.0"}</div>
            </div>

            <div class="border-t border-slate-200 pt-3">
              <span class="text-[9px] font-black tracking-widest text-slate-400 uppercase">Timestamp</span>
              <div class="text-xs font-bold text-slate-800 mt-0.5">${new Date(node.timestamp).toLocaleString()}</div>
            </div>

            <div class="border-t border-slate-200 pt-3">
              <span class="text-[9px] font-black tracking-widest text-slate-400 uppercase">Cryptographic Meta Hash</span>
              <div class="text-[9px] font-mono text-emerald-700 mt-1 break-all bg-white p-2.5 rounded border border-slate-200">${node.meta_hash}</div>
            </div>

            <div class="border-t border-slate-200 pt-3">
              <span class="text-[9px] font-black tracking-widest text-slate-400 uppercase">Payload Data Hash</span>
              <div class="text-[9px] font-mono text-slate-700 mt-1 break-all bg-white p-2.5 rounded border border-slate-200">${node.data_hash}</div>
            </div>

            <div class="border-t border-slate-200 pt-3">
              <span class="text-[9px] font-black tracking-widest text-slate-400 uppercase">Previous Link Reference</span>
              <div class="text-[9px] font-mono text-slate-400 mt-1 break-all bg-white p-2.5 rounded border border-slate-200">${node.prev_meta_hash}</div>
            </div>
          </div>
        `;
      }
    }

    function renderYamlPayloadsList(nodes) {
      const container = document.getElementById("yaml-list-content");
      if (!container) return;

      if (!nodes || nodes.length === 0) {
        container.innerHTML = `<div class="text-center py-12 text-xs text-slate-500 italic">No package history log initialized yet.</div>`;
        return;
      }

      // Filter out root nodes (Genesis Anchor) and sort in chronological order (oldest on top)
      const blocksOnly = nodes.filter(n => n.type !== "root").sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp));

      if (blocksOnly.length === 0) {
        container.innerHTML = `<div class="text-center py-12 text-xs text-slate-500 italic">No blocks found in ledger lineage.</div>`;
        return;
      }

      // Helper to extract manifests from a node payload
      function getManifestsForNode(node) {
        let manifests = [];
        try {
          const parsedData = jsyaml.load(node.data_payload);
          if (parsedData && typeof parsedData === "object") {
            const systemKeys = [
              "chain_event", "genesis_rollover", "genesis_key", 
              "rollover_reason", "rollover_authority", "previous_epoch", 
              "lockfiles", "step"
            ];
            const rootKeys = Object.keys(parsedData).filter(k => !systemKeys.includes(k));
            
            const lockfilesKeys = [];
            if (parsedData.lockfiles && typeof parsedData.lockfiles === "object") {
              lockfilesKeys.push(...Object.keys(parsedData.lockfiles));
            }

            manifests = [...new Set([...rootKeys, ...lockfilesKeys])];
          }
        } catch(e) {}
        if (manifests.length === 0) {
          manifests = ["other"];
        }
        return manifests;
      }

      // Calculate min and max line counts for >0 counts
      let maxLines = 0;
      let minLines = Infinity;
      blocksOnly.forEach((node) => {
        const lineCount = (node.data_payload || "").split("\n").length;
        if (lineCount > 0) {
          if (lineCount > maxLines) maxLines = lineCount;
          if (lineCount < minLines) minLines = lineCount;
        }
      });
      if (minLines === Infinity) {
        minLines = 0;
      }

      // Group blocks by epoch and assign epoch indices
      const epochs = [];
      let currentEpochBlocks = [];
      let epochIdx = 0;
      
      blocksOnly.forEach((node) => {
        if (node.type === "rollover" && currentEpochBlocks.length > 0) {
          epochs.push(currentEpochBlocks);
          currentEpochBlocks = [];
          epochIdx++;
        }
        node.epoch_index = epochIdx;
        currentEpochBlocks.push(node);
      });
      if (currentEpochBlocks.length > 0) {
        epochs.push(currentEpochBlocks);
      }

      function getManifestColors(manifest) {
        const name = (manifest || "").toLowerCase();
        if (name.includes("package-lock")) {
          return {
            bg: "rgba(16, 185, 129, 0.04)",
            border: "#10b981",
            dot: "#10b981",
            label: "npm"
          };
        } else if (name.includes("bun")) {
          return {
            bg: "rgba(139, 92, 246, 0.04)",
            border: "#8b5cf6",
            dot: "#8b5cf6",
            label: "bun"
          };
        } else if (name.includes("yarn")) {
          return {
            bg: "rgba(14, 165, 233, 0.04)",
            border: "#0ea5e9",
            dot: "#0ea5e9",
            label: "yarn"
          };
        } else if (name.includes("pnpm")) {
          return {
            bg: "rgba(245, 158, 11, 0.04)",
            border: "#f59e0b",
            dot: "#f59e0b",
            label: "pnpm"
          };
        } else {
          return {
            bg: "rgba(100, 116, 139, 0.04)",
            border: "#64748b",
            dot: "#64748b",
            label: "raw"
          };
        }
      }

      container.innerHTML = "";
      
      const minimap = document.getElementById("chain-minimap");
      if (minimap) {
        minimap.innerHTML = "";
      }

      const timeline = document.getElementById("chain-timeline");
      if (timeline) {
        timeline.innerHTML = "";
      }

      // 1. Render all block cards in the main container
      blocksOnly.forEach((node) => {
        const item = document.createElement("div");
        item.id = `block-card-${node.epoch_index}-${node.block_index}`;
        item.className = "border-b border-slate-200 pb-6 mb-6 last:border-b-0 last:pb-0 last:mb-0 flex flex-col gap-3 relative group transition-all duration-300";

        const badge = node.identityBadge ? `<span class="text-[8px] font-bold px-1.5 py-0.2 rounded border border-violet-200 bg-violet-50 text-violet-700 uppercase tracking-wider">${node.identityBadge}</span>` : '';

        item.innerHTML = `
          <!-- Block Header line styled as a YAML comment/divider -->
          <div class="flex justify-between items-center text-[10px] text-slate-400 font-mono border-b border-slate-100 pb-1.5 mb-1 select-none">
            <div class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">---</span>
              <span class="text-slate-700 font-bold"># BLOCK #${node.block_index} (EPOCH ${node.epoch_index})</span>
              <span class="text-slate-400">(${node.meta_hash.slice(0, 12)}...)</span>
              <span class="text-slate-400">${new Date(node.timestamp).toLocaleString()}</span>
              ${node.type === 'rollover' ? '<span class="text-amber-600 font-bold uppercase text-[9px]">[ROLLOVER]</span>' : ''}
              ${badge}
            </div>
            <div class="opacity-0 group-hover:opacity-100 transition-opacity flex gap-2">
              <button onclick="copyDataText(this)" class="text-slate-400 hover:text-slate-700 text-[10px] cursor-pointer hover:underline bg-transparent border-0 p-0">Copy Data</button>
              <button onclick="copyMetaText(this)" class="text-slate-400 hover:text-slate-700 text-[10px] cursor-pointer hover:underline bg-transparent border-0 p-0">Copy Metadata</button>
            </div>
          </div>

          <!-- Data Payload (always expanded) -->
          <div class="pl-4 border-l-2 border-slate-200 text-slate-800 data-payload-container">
            <pre class="bg-transparent text-slate-800 font-mono text-xs overflow-x-auto whitespace-pre-wrap select-text leading-relaxed">${highlightYaml(node.data_payload)}</pre>
          </div>

          <!-- Meta Payload (collapsed by default) -->
          <div class="mt-2 pl-4 border-l-2 border-slate-200 flex flex-col gap-2">
            <!-- Collapsible Trigger -->
            <button onclick="toggleMetaSection(this)" class="text-[10px] text-slate-400 hover:text-slate-600 font-mono flex items-center gap-1.5 focus:outline-none cursor-pointer w-fit select-none bg-transparent border-0 p-0">
              <span class="transform transition-transform duration-150 inline-block font-bold">▶</span>
              <span class="font-bold"># view verification metadata</span>
            </button>
            <!-- Collapsible Content -->
            <div class="hidden mt-1 pl-3 border-l border-slate-200/60 meta-payload-container">
              <pre class="bg-slate-100/70 text-slate-600 font-mono text-[10px] p-2.5 rounded border border-slate-200 overflow-x-auto whitespace-pre-wrap select-text leading-normal">${highlightYaml(node.meta_payload)}</pre>
            </div>
          </div>
        `;
        container.appendChild(item);
      });

      // 2. Render epoch columns in the minimap
      if (minimap) {
        epochs.forEach((epochBlocks, epochIdx) => {
          const epochCol = document.createElement("div");
          epochCol.className = "w-16 flex flex-col select-none overflow-y-auto divide-y divide-slate-100 flex-shrink-0";
          epochCol.style.minWidth = "64px";
          epochCol.style.scrollbarWidth = "none";
          epochCol.style.msOverflowStyle = "none";

          const header = document.createElement("div");
          header.className = "bg-slate-100/80 backdrop-blur-sm border-b border-slate-200 text-[8px] font-bold font-mono text-center py-1.5 text-slate-500 uppercase select-none sticky top-0 z-10 tracking-wider";
          header.innerText = `EPOCH ${epochIdx}`;
          epochCol.appendChild(header);

          epochBlocks.forEach((node) => {
            const lines = (node.data_payload || "").split("\n");
            const lineCount = lines.length;

            const manifests = getManifestsForNode(node);
            const manifestCount = (manifests.length === 1 && manifests[0] === "other") ? 0 : manifests.length;
            const manifest = manifests.find(k => k.endsWith(".json") || k.endsWith(".lockb") || k.endsWith(".yaml") || k.endsWith(".toml")) || manifests[0];
            const colors = getManifestColors(manifest);
            
            const slice = document.createElement("div");
            slice.className = "cursor-pointer transition-all hover:brightness-95 select-none";
            slice.style.display = "flex";
            slice.style.flexDirection = "column";
            slice.style.alignItems = "center";
            slice.style.justifyContent = "center";
            slice.style.gap = "2px";
            slice.style.padding = "2px";
            slice.style.boxSizing = "border-box";
            slice.style.backgroundColor = colors.bg;
            slice.style.borderLeft = `3px solid ${colors.border}`;
            slice.style.height = "26px";
            slice.title = `Epoch ${epochIdx} - Block #${node.block_index}\nTracked Manifests: ${manifestCount}\nPrimary: ${manifest}\nLines: ${lineCount}`;

            const dotsContainer = document.createElement("div");
            dotsContainer.style.display = "flex";
            dotsContainer.style.flexDirection = "row";
            dotsContainer.style.gap = "1.5px";
            
            const totalDots = 8;
            let activeDots = 0;
            if (lineCount > 0) {
              if (maxLines === minLines) {
                activeDots = 8;
              } else if (lineCount === minLines) {
                activeDots = 1;
              } else if (lineCount === maxLines) {
                activeDots = 8;
              } else {
                const ratio = (lineCount - minLines) / (maxLines - minLines);
                activeDots = 2 + Math.min(5, Math.floor(ratio * 6));
              }
            }
            
            for (let i = 0; i < totalDots; i++) {
              const dot = document.createElement("div");
              dot.style.width = "4px";
              dot.style.height = "4px";
              dot.style.borderRadius = "0.5px";
              if (i < activeDots) {
                dot.style.backgroundColor = colors.dot;
              } else {
                dot.style.backgroundColor = "rgba(15, 23, 42, 0.12)"; // clearly visible but inactive
              }
              dotsContainer.appendChild(dot);
            }
            slice.appendChild(dotsContainer);

            const formatLabel = document.createElement("span");
            formatLabel.style.fontSize = "7.5px";
            formatLabel.style.lineHeight = "1";
            formatLabel.style.color = "#94a3b8"; // Slate 400
            formatLabel.style.textTransform = "uppercase";
            formatLabel.style.fontFamily = "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace";
            formatLabel.style.userSelect = "none";
            formatLabel.innerText = colors.label;
            slice.appendChild(formatLabel);

            slice.addEventListener("click", () => {
              const card = document.getElementById(`block-card-${epochIdx}-${node.block_index}`);
              if (card) {
                card.scrollIntoView({ behavior: 'auto', block: 'start' });
                
                // Highlight active block card visually
                card.classList.add("bg-indigo-50/50");
                card.style.outline = "2px solid #4f46e5";
                card.style.outlineOffset = "2px";
                setTimeout(() => {
                  card.classList.remove("bg-indigo-50/50");
                  card.style.outline = "none";
                }, 1500);
              }
            });

            epochCol.appendChild(slice);
          });

          minimap.appendChild(epochCol);
        });
      }

      // 3. Render git history styled timeline column
      if (timeline) {
        // Group blocks by day
        const blocksByDay = {};
        blocksOnly.forEach((node) => {
          const dateStr = new Date(node.timestamp).toISOString().slice(0, 10);
          if (!blocksByDay[dateStr]) {
            blocksByDay[dateStr] = [];
          }
          blocksByDay[dateStr].push(node);
        });

        // Sorted list of days
        const daysList = Object.keys(blocksByDay).sort();

        if (daysList.length > 0) {
          // Identify all unique manifests
          const allManifestsSet = new Set();
          blocksOnly.forEach(node => {
            getManifestsForNode(node).forEach(m => allManifestsSet.add(m));
          });
          const uniqueManifests = Array.from(allManifestsSet).sort();

          // Dynamically adjust timeline container width based on number of manifests
          const svgWidth = uniqueManifests.length * 16;
          const neededWidth = 42 + 8 + 16 + svgWidth + 24; // dateLabel + gap + padding + svg + buffer
          timeline.style.width = `${Math.max(140, neededWidth)}px`;

          // Create standard sticky container for TIMELINE header and legend
          const headerContainer = document.createElement("div");
          headerContainer.className = "sticky top-0 z-10 flex flex-col bg-slate-100/80 backdrop-blur-sm border-b border-slate-200 w-full";
          headerContainer.style.boxSizing = "border-box";

          const tlHeader = document.createElement("div");
          tlHeader.className = "text-[8px] font-bold font-mono text-center py-1.5 text-slate-500 uppercase select-none tracking-wider";
          tlHeader.innerText = "TIMELINE";
          headerContainer.appendChild(tlHeader);

          timeline.appendChild(headerContainer);

          // Calculate manifest ranges
          const manifestRanges = {};
          uniqueManifests.forEach(m => {
            manifestRanges[m] = { first: -1, last: -1 };
          });
          uniqueManifests.forEach(m => {
            let first = -1;
            let last = -1;
            daysList.forEach((dayStr, idx) => {
              const blocks = blocksByDay[dayStr];
              const hasManifest = blocks.some(node => getManifestsForNode(node).includes(m));
              if (hasManifest) {
                if (first === -1) first = idx;
                last = idx;
              }
            });
            manifestRanges[m] = { first, last };
          });

          // Render legend inside the sticky header container
          const legend = document.createElement("div");
          legend.className = "flex flex-row items-center justify-start gap-2 py-1 px-2 border-t border-slate-200/60 text-[8px] font-mono text-slate-500 overflow-x-auto select-none flex-wrap w-full";
          legend.style.boxSizing = "border-box";
          legend.style.scrollbarWidth = "none";
          legend.style.msOverflowStyle = "none";
          uniqueManifests.forEach(m => {
            const item = document.createElement("div");
            item.className = "flex items-center gap-1 flex-shrink-0";
            
            const colors = getManifestColors(m);
            const indicator = document.createElement("span");
            indicator.style.width = "6px";
            indicator.style.height = "6px";
            indicator.style.borderRadius = "50%";
            indicator.style.backgroundColor = colors.dot;
            indicator.style.display = "inline-block";
            
            const label = document.createElement("span");
            label.innerText = colors.label;
            
            item.appendChild(indicator);
            item.appendChild(label);
            legend.appendChild(item);
          });
          headerContainer.appendChild(legend);

          // Render each day row
          daysList.forEach((dayStr, dayIdx) => {
            const blocksOnDay = blocksByDay[dayStr];
            
            const row = document.createElement("div");
            row.className = "flex items-center hover:bg-slate-50/50 px-2 py-1 gap-2 border-b border-slate-100/50 transition-colors";
            row.style.height = "36px";
            row.style.boxSizing = "border-box";

            // Format date label (e.g. "Jun 5")
            let dateLabel = dayStr;
            try {
              const dateObj = new Date(dayStr + "T00:00:00");
              const options = { month: 'short', day: 'numeric' };
              dateLabel = dateObj.toLocaleDateString('en-US', options);
            } catch(e) {}

            const dateDiv = document.createElement("div");
            dateDiv.style.width = "42px";
            dateDiv.style.textAlign = "right";
            dateDiv.style.fontSize = "8px";
            dateDiv.style.fontWeight = "bold";
            dateDiv.style.fontFamily = "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace";
            dateDiv.style.color = "#64748b";
            dateDiv.style.userSelect = "none";
            dateDiv.style.flexShrink = "0";
            dateDiv.innerText = dateLabel;
            row.appendChild(dateDiv);

            // SVG Container for Git history-like lines and dots
            const svgWidth = uniqueManifests.length * 16;
            const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
            svg.setAttribute("width", svgWidth);
            svg.setAttribute("height", "36");
            svg.style.flexShrink = "0";

            uniqueManifests.forEach((m, mIdx) => {
              const x = mIdx * 16 + 8;
              const range = manifestRanges[m];
              const hasLine = range.first !== -1 && dayIdx >= range.first && dayIdx <= range.last;
              const hasDot = blocksOnDay.some(node => getManifestsForNode(node).includes(m));
              const colors = getManifestColors(m);

              if (hasLine) {
                let y1 = 0;
                let y2 = 36;
                if (dayIdx === range.first) {
                  y1 = 18; // Start at center
                }
                if (dayIdx === range.last) {
                  y2 = 18; // End at center
                }

                if (range.first === range.last) {
                  // Only 1 day, no vertical line, just the dot
                } else {
                  const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
                  line.setAttribute("x1", x);
                  line.setAttribute("y1", y1);
                  line.setAttribute("x2", x);
                  line.setAttribute("y2", y2);
                  line.setAttribute("stroke", colors.border);
                  line.setAttribute("stroke-width", "2");
                  line.setAttribute("stroke-linecap", "round");
                  svg.appendChild(line);
                }
              }

              if (hasDot) {
                const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
                circle.setAttribute("cx", x);
                circle.setAttribute("cy", "18");
                circle.setAttribute("r", "4");
                circle.setAttribute("fill", colors.dot);
                circle.setAttribute("stroke", "#ffffff");
                circle.setAttribute("stroke-width", "1.5");
                
                const title = document.createElementNS("http://www.w3.org/2000/svg", "title");
                const count = blocksOnDay.filter(node => getManifestsForNode(node).includes(m)).length;
                title.textContent = `${m}\nDate: ${dayStr}\nCommits: ${count}`;
                circle.appendChild(title);
                
                circle.style.cursor = "pointer";
                circle.addEventListener("click", () => {
                  const firstBlock = blocksOnDay.find(node => getManifestsForNode(node).includes(m));
                  if (firstBlock) {
                    const card = document.getElementById(`block-card-${firstBlock.epoch_index}-${firstBlock.block_index}`);
                    if (card) {
                      card.scrollIntoView({ behavior: 'auto', block: 'start' });
                      card.classList.add("bg-indigo-50/50");
                      card.style.outline = "2px solid #4f46e5";
                      card.style.outlineOffset = "2px";
                      setTimeout(() => {
                        card.classList.remove("bg-indigo-50/50");
                        card.style.outline = "none";
                      }, 1500);
                    }
                  }
                });

                svg.appendChild(circle);
              }
            });

            row.appendChild(svg);
            timeline.appendChild(row);
          });
        }
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function highlightYaml(yaml) {
      if (!yaml) return "";
      let html = escapeHtml(yaml);

      const regex = /(#[^\n]*)|(^[ \t]*(?:-\s*)?)([a-zA-Z0-9_.\-\/]+)(:)|(&quot;.*?&quot;)|(&#039;.*?&#039;)|\b(true|false|null)\b|\b(\d+(?:\.\d+)?)\b/gm;

      html = html.replace(regex, (match, comment, indent, key, colon, dstr, sstr, val, num) => {
        if (comment) {
          return `<span class="text-slate-400 italic">${comment}</span>`;
        }
        if (key) {
          return `${indent}<span class="text-indigo-700 font-semibold">${key}</span>${colon}`;
        }
        if (dstr) {
          return `<span class="text-emerald-600 font-medium">${dstr}</span>`;
        }
        if (sstr) {
          return `<span class="text-emerald-600 font-medium">${sstr}</span>`;
        }
        if (val) {
          return `<span class="text-amber-600 font-bold">${val}</span>`;
        }
        if (num) {
          return `<span class="text-sky-600">${num}</span>`;
        }
        return match;
      });

      return html;
    }

    window.copyDataText = function(btn) {
      const container = btn.closest(".group");
      const pre = container.querySelector(".data-payload-container pre");
      if (!pre) return;
      navigator.clipboard.writeText(pre.textContent).then(() => {
        const orig = btn.innerText;
        btn.innerText = 'Copied!';
        setTimeout(() => { btn.innerText = orig; }, 1500);
      });
    };

    window.copyMetaText = function(btn) {
      const container = btn.closest(".group");
      const pre = container.querySelector(".meta-payload-container pre");
      if (!pre) return;
      navigator.clipboard.writeText(pre.textContent).then(() => {
        const orig = btn.innerText;
        btn.innerText = 'Copied!';
        setTimeout(() => { btn.innerText = orig; }, 1500);
      });
    };

    window.toggleMetaSection = function(btn) {
      const content = btn.nextElementSibling;
      const arrow = btn.querySelector("span");
      if (content.classList.contains("hidden")) {
        content.classList.remove("hidden");
        arrow.style.transform = "rotate(90deg)";
      } else {
        content.classList.add("hidden");
        arrow.style.transform = "";
      }
    };
  }
</script>
