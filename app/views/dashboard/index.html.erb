<div class="flex flex-col gap-8 w-full">
  <!-- Title / Top Action Row -->
  <div class="flex justify-between items-center flex-wrap gap-4">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-white">Trust Registry Console</h1>
      <p class="text-sm text-gray-400">Zero-trust supply chain audit logs & repository integrity checks.</p>
    </div>
    <div class="flex gap-3">
      <%= button_to "GC Stale Signups", purge_stale_repositories_path, method: :post, class: "px-4 py-2 text-xs font-bold rounded-lg border border-[#ef4444]/30 bg-[#ef4444]/10 text-[#ef4444] cursor-pointer hover:bg-[#ef4444] hover:text-black transition-all uppercase tracking-wider" %>
      <%= link_to "+ Create Project", new_project_path, class: "px-4 py-2 text-xs font-bold rounded-lg bg-[#10b981] text-black cursor-pointer hover:bg-[#10b981]/90 hover:shadow-md hover:shadow-[#10b981]/15 transition-all uppercase tracking-wider flex items-center" %>
    </div>
  </div>

  <!-- Diagnostics Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="p-6 rounded-xl border border-[#1f2937] bg-[#111827]/30 flex flex-col gap-2 relative overflow-hidden group">
      <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-[#10b981]/5 rounded-full blur-xl group-hover:bg-[#10b981]/10 transition-all"></div>
      <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Active Core CPU</span>
      <span class="text-2xl font-black text-white"><%= @metrics[:cpu] %></span>
      <span class="text-xs text-[#10b981] font-semibold flex items-center gap-1">🟢 Low utilization</span>
    </div>

    <div class="p-6 rounded-xl border border-[#1f2937] bg-[#111827]/30 flex flex-col gap-2 relative overflow-hidden group">
      <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-[#8b5cf6]/5 rounded-full blur-xl group-hover:bg-[#8b5cf6]/10 transition-all"></div>
      <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Memory Allocation</span>
      <span class="text-2xl font-black text-white"><%= @metrics[:memory] %></span>
      <span class="text-xs text-[#8b5cf6] font-semibold flex items-center gap-1">🟢 Allocations optimized</span>
    </div>

    <div class="p-6 rounded-xl border border-[#1f2937] bg-[#111827]/30 flex flex-col gap-2 relative overflow-hidden group">
      <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-[#06b6d4]/5 rounded-full blur-xl group-hover:bg-[#06b6d4]/10 transition-all"></div>
      <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Registry SQL Disk</span>
      <span class="text-2xl font-black text-white"><%= @metrics[:disk] %></span>
      <span class="text-xs text-[#06b6d4] font-semibold flex items-center gap-1">🟢 Healthy read/write</span>
    </div>

    <div class="p-6 rounded-xl border border-[#1f2937] bg-[#111827]/30 flex flex-col gap-2 relative overflow-hidden group">
      <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-[#10b981]/5 rounded-full blur-xl group-hover:bg-[#10b981]/10 transition-all"></div>
      <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Registry Gateway</span>
      <span class="text-2xl font-black <%= @status_secured ? 'text-[#10b981]' : 'text-[#ef4444]' %>"><%= @metrics[:health] %></span>
      <span class="text-xs text-gray-400 font-semibold flex items-center gap-1">
        API status: <%= @system_status["status"] %>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left / Center: Projects Hub (2 Cols wide) -->
    <div class="lg:col-span-2 flex flex-col gap-6">
      <div class="border border-[#1f2937] rounded-xl bg-[#111827]/20 p-6 flex flex-col gap-6">
        <div>
          <h2 class="text-xl font-bold text-white">Logical Project Containers</h2>
          <p class="text-xs text-gray-400">Purely visual environment groups stored in local Rails SQL database.</p>
        </div>

        <% if @projects.empty? %>
          <div class="p-8 text-center border border-dashed border-[#1f2937] rounded-xl flex flex-col gap-4">
            <span class="text-2xl">📂</span>
            <p class="text-sm text-gray-500">No projects mapped yet. Create one to organize repositories.</p>
            <%= link_to "+ Create First Project", new_project_path, class: "mx-auto px-4 py-2 text-xs font-bold rounded-lg bg-[#111827] border border-[#1f2937] text-white hover:bg-[#1f2937] transition-all" %>
          </div>
        <% else %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% @projects.each do |project| %>
              <div class="p-5 rounded-lg border border-[#1f2937] bg-[#0b0f19] flex flex-col gap-4 hover:border-gray-500 transition-colors">
                <div class="flex justify-between items-start">
                  <div>
                    <h3 class="font-bold text-white text-base"><%= project.name %></h3>
                    <span class="text-[10px] text-gray-500 uppercase font-semibold">
                      <%= project.project_repositories.count %> linked ledgers
                    </span>
                  </div>
                  <div class="flex gap-2">
                    <%= link_to "Manage", project_path(project), class: "text-xs font-bold text-[#10b981] hover:underline" %>
                    <%= link_to "Edit", edit_project_path(project), class: "text-xs font-bold text-gray-400 hover:underline" %>
                  </div>
                </div>

                <div class="flex flex-col gap-1 border-t border-[#1f2937] pt-3">
                  <% linked_repos = @repositories.select { |r| project.project_repositories.pluck(:repo_id).include?(r["id"]) } %>
                  <% if linked_repos.empty? %>
                    <span class="text-xs text-gray-600 italic">No repositories linked.</span>
                  <% else %>
                    <% linked_repos.first(3).each do |repo| %>
                      <div class="flex items-center justify-between text-xs">
                        <%= link_to "#{repo['owner']}/#{repo['repo']}", repository_path(repo['id']), class: "text-gray-300 hover:text-white truncate font-medium hover:underline max-w-[180px]" %>
                        <% if repo["is_premium"] == 1 %>
                          <span class="text-[9px] px-1 py-0.2 rounded border border-[#8b5cf6]/30 bg-[#8b5cf6]/10 text-[#8b5cf6] font-bold uppercase">Prem</span>
                        <% else %>
                          <span class="text-[9px] px-1 py-0.2 rounded border border-gray-600 bg-gray-800 text-gray-400 font-bold uppercase">Std</span>
                        <% end %>
                      </div>
                    <% end %>
                    <% if linked_repos.count > 3 %>
                      <span class="text-[10px] text-gray-500 font-bold italic pt-1">
                        + <%= linked_repos.count - 3 %> more...
                      </span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right: Global Repository Ledgers (1 Col wide) -->
    <div class="flex flex-col gap-6">
      <div class="border border-[#1f2937] rounded-xl bg-[#111827]/20 p-6 flex flex-col gap-6">
        <div>
          <h2 class="text-xl font-bold text-white">Registered Ledgers</h2>
          <p class="text-xs text-gray-400">Real-time status of all active package registers.</p>
        </div>

        <% if @repositories.empty? %>
          <p class="text-sm text-gray-500 italic py-4">No active package registries found.</p>
        <% else %>
          <div class="flex flex-col gap-3">
            <% @repositories.each do |repo| %>
              <div class="p-4 rounded-lg border border-[#1f2937] bg-[#0b0f19] flex flex-col gap-3">
                <div class="flex justify-between items-start gap-2">
                  <div class="truncate">
                    <%= link_to "#{repo['owner']}/#{repo['repo']}", repository_path(repo['id']), class: "font-bold text-xs text-gray-200 hover:text-white truncate font-mono hover:underline block max-w-[180px]" %>
                    <span class="text-[9px] text-gray-500 font-bold">挑戰 ID: <%= repo["id"] %></span>
                  </div>
                  <div>
                    <% if repo["is_premium"] == 1 %>
                      <span class="text-[8px] font-black tracking-wide px-1.5 py-0.5 rounded border border-[#8b5cf6]/30 bg-[#8b5cf6]/10 text-[#8b5cf6] uppercase">PREMIUM</span>
                    <% else %>
                      <span class="text-[8px] font-black tracking-wide px-1.5 py-0.5 rounded border border-gray-600 bg-gray-800 text-gray-400 uppercase">STANDARD</span>
                    <% end %>
                  </div>
                </div>

                <div class="flex justify-between items-center text-[10px] border-t border-[#1f2937] pt-2 mt-1">
                  <div class="flex items-center gap-1.5">
                    <% if repo["registration_token"].start_with?("pb_revoked_") %>
                      <span class="w-1.5 h-1.5 rounded-full bg-[#ef4444] inline-block"></span>
                      <span class="text-[#ef4444] font-bold">REVOKED</span>
                    <% else %>
                      <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] inline-block"></span>
                      <span class="text-gray-400 font-mono text-[9px]">pb_reg_...<%= repo["registration_token"][-6..-1] if repo["registration_token"] %></span>
                    <% end %>
                  </div>
                  <div class="flex gap-2.5">
                    <%= button_to "Revoke", revoke_repository_path(repo["id"]), method: :post, data: { confirm: "Are you sure you want to permanently revoke this repository token?" }, class: "text-[9px] font-bold text-[#ef4444] hover:underline bg-transparent border-0 cursor-pointer p-0" unless repo["registration_token"].start_with?("pb_revoked_") %>
                    <%= button_to "Toggle Premium", toggle_premium_repository_path(repo["id"]), method: :post, class: "text-[9px] font-bold text-[#8b5cf6] hover:underline bg-transparent border-0 cursor-pointer p-0" %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
