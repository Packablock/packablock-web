<div class="flex flex-col gap-8 w-full">
  <!-- Title / Top Action Row -->
  <div class="flex justify-between items-center flex-wrap gap-4">
    <div class="flex items-center gap-3">
      <div class="p-2 bg-slate-100 rounded-xl text-slate-700 border border-slate-200 shadow-sm flex items-center justify-center">
        <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" fill="none" stroke="none" role="img" aria-label="Packablock mark">
          <line x1="60" y1="24" x2="60" y2="96" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
          <rect x="37" y="42" width="46" height="36" rx="9" fill="currentColor"/>
          <circle cx="60" cy="24" r="9" fill="currentColor"/>
          <circle cx="60" cy="96" r="9" fill="currentColor"/>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Registry Dashboard</h1>
        </div>
        <p class="text-sm text-slate-500">Zero-trust supply chain audit logs & repository integrity checks.</p>
      </div>
    </div>

  </div>

  <div class="flex flex-col gap-6">
    <div class="border border-slate-200 rounded-xl bg-white shadow-sm p-6 flex flex-col gap-6">
      <div class="flex justify-between items-center flex-wrap gap-4">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Logical Project Containers</h2>
          <p class="text-xs text-slate-500">Purely visual environment groups stored in local Rails SQL database.</p>
        </div>
        <%= link_to "+ Create Project", new_project_path, class: "px-4 py-2 text-xs font-bold rounded-lg bg-emerald-600 text-white cursor-pointer hover:bg-emerald-700 hover:shadow-md transition-all uppercase tracking-wider flex items-center" %>
      </div>

      <% if @projects.empty? %>
        <div class="p-8 text-center border border-dashed border-slate-200 rounded-xl flex flex-col gap-4">
          <span class="text-2xl">📂</span>
          <p class="text-sm text-slate-500">No projects mapped yet. Create one to organize repositories.</p>
          <%= link_to "+ Create First Project", new_project_path, class: "mx-auto px-4 py-2 text-xs font-bold rounded-lg bg-slate-100 border border-slate-200 text-slate-700 hover:bg-slate-200 transition-all" %>
        </div>
      <% else %>
        <div class="flex flex-col border border-slate-200 rounded-xl divide-y divide-slate-150 overflow-hidden bg-white">
          <!-- Table Header -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 bg-slate-50/75 px-6 py-3.5 text-xs font-bold text-slate-400 uppercase tracking-wider">
            <div class="md:col-span-4 flex items-center gap-2">Project Container</div>
            <div class="md:col-span-6 flex items-center">Linked Repository Ledgers</div>
            <div class="md:col-span-2 flex items-center md:justify-end">Actions</div>
          </div>

          <% @projects.each do |project| %>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 px-6 py-4.5 items-center hover:bg-slate-50/40 transition-colors">
              <!-- Project Info -->
              <div class="md:col-span-4 flex items-start gap-3">
                <div class="p-2 bg-slate-100 rounded-lg text-slate-600 border border-slate-200/60 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <%= link_to project.name, project_path(project), class: "font-bold text-slate-900 hover:text-emerald-600 text-base transition-colors hover:underline block truncate" %>
                  <span class="text-xs text-slate-400 font-semibold block mt-0.5">
                    <%= project.project_repositories.count %> linked ledgers
                  </span>
                </div>
              </div>

              <!-- Linked Repositories -->
              <div class="md:col-span-6">
                <% linked_repos = @repositories.select { |r| project.project_repositories.pluck(:repo_id).include?(r["id"]) } %>
                <% if linked_repos.empty? %>
                  <span class="text-xs text-slate-400 italic">No repositories linked to this container.</span>
                <% else %>
                  <div class="flex flex-wrap gap-2">
                    <% linked_repos.each do |repo| %>
                      <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-slate-200 bg-slate-50/50 max-w-full">
                        <%= link_to "#{repo['owner']}/#{repo['repo']}", repository_path(repo['id']), class: "text-xs font-mono font-medium text-slate-600 hover:text-slate-900 truncate max-w-[160px] hover:underline" %>
                        <% if repo["is_premium"] == 1 %>
                          <span class="text-[8px] font-bold px-1 py-0.2 rounded border border-[#8b5cf6]/30 bg-[#8b5cf6]/10 text-[#8b5cf6] uppercase tracking-wider flex-shrink-0">Prem</span>
                        <% else %>
                          <span class="text-[8px] font-bold px-1 py-0.2 rounded border border-slate-200 bg-slate-100 text-slate-500 uppercase tracking-wider flex-shrink-0">Std</span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Actions -->
              <div class="md:col-span-2 flex items-center md:justify-end gap-3">
                <%= link_to "Manage", project_path(project), class: "px-3 py-1.5 text-xs font-bold rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-600 hover:bg-emerald-600 hover:text-white transition-all uppercase tracking-wider text-center min-w-[76px]" %>
                <%= link_to "Edit", edit_project_path(project), class: "px-3 py-1.5 text-xs font-bold rounded-lg border border-slate-200 bg-slate-50 text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition-all uppercase tracking-wider text-center min-w-[64px]" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
