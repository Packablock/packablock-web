<div class="flex flex-col gap-8 w-full">
  <!-- Title Header Row -->
  <div class="flex justify-between items-start flex-wrap gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-gray-500 font-semibold uppercase tracking-wider mb-1">
        <%= link_to "Dashboard", dashboard_path, class: "hover:text-white" %>
        <span>/</span>
        <span class="text-white">Projects</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-white"><%= @project.name %></h1>
      <p class="text-sm text-gray-400">Map and group supply chain trust registries under this project environment.</p>
    </div>
    <div class="flex gap-3">
      <%= button_to "Delete Project", project_path(@project), method: :delete, data: { confirm: "Are you sure you want to permanently delete this project?" }, class: "px-4 py-2 text-xs font-bold rounded-lg border border-[#ef4444]/30 bg-[#ef4444]/10 text-[#ef4444] cursor-pointer hover:bg-[#ef4444] hover:text-black transition-all uppercase tracking-wider" %>
      <%= link_to "Back to Dashboard", dashboard_path, class: "px-4 py-2 text-xs font-bold rounded-lg border border-[#1f2937] text-gray-400 hover:text-white hover:border-gray-500 transition-colors uppercase tracking-wider flex items-center justify-center" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left: Linked Repositories (2 Cols wide) -->
    <div class="lg:col-span-2 flex flex-col gap-6">
      <div class="border border-[#1f2937] rounded-xl bg-[#111827]/20 p-6 flex flex-col gap-6">
        <div>
          <h2 class="text-xl font-bold text-white">Linked Registries</h2>
          <p class="text-xs text-gray-400">Repositories associated with this environment container.</p>
        </div>

        <% if @linked_repositories.empty? %>
          <div class="p-8 text-center border border-dashed border-[#1f2937] rounded-xl flex flex-col gap-3">
            <span class="text-xl">🔗</span>
            <p class="text-sm text-gray-500">No repositories linked to this project container yet.</p>
          </div>
        <% else %>
          <div class="flex flex-col gap-4">
            <% @linked_repositories.each do |repo| %>
              <div class="p-5 rounded-lg border border-[#1f2937] bg-[#0b0f19] flex justify-between items-center gap-4 hover:border-gray-500 transition-all">
                <div>
                  <%= link_to "#{repo['owner']}/#{repo['repo']}", repository_path(repo['id']), class: "font-mono font-bold text-sm text-[#10b981] hover:underline" %>
                  <div class="text-[10px] text-gray-500 font-semibold mt-1 flex items-center gap-2">
                    <span>ID: <%= repo["id"] %></span>
                    <span>•</span>
                    <% if repo["is_premium"] == 1 %>
                      <span class="text-[#8b5cf6] font-bold">PREMIUM TIER</span>
                    <% else %>
                      <span class="text-gray-400">STANDARD TIER</span>
                    <% end %>
                  </div>
                </div>
                
                <%= button_to "Unlink Repository", unlink_repository_project_path(@project, repo_id: repo["id"]), method: :delete, class: "px-3 py-1.5 text-[10px] font-bold rounded border border-[#ef4444]/30 bg-[#ef4444]/10 text-[#ef4444] cursor-pointer hover:bg-[#ef4444] hover:text-black transition-all uppercase tracking-wider" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Candlestick Charts Section -->
      <% unless @linked_repositories.empty? %>
        <% @linked_repositories.each do |repo| %>
          <div class="border border-[#1f2937] rounded-xl bg-[#111827]/20 p-6 flex flex-col gap-4 mt-6">
            <div>
              <h3 class="text-lg font-bold text-white">SemVer Candlestick Timelines: <%= repo['owner'] %>/<%= repo['repo'] %></h3>
              <p class="text-xs text-gray-400">Visualizes package constraints (wick), active version timeline (body), current pinned version (dot), and upstream release drift (line/endpoint).</p>
            </div>
            
            <div id="candlestick-chart-<%= repo['id'] %>" data-url="<%= candlesticks_repository_path(repo['id']) %>" class="candlestick-chart w-full bg-[#0b0f19]/30 rounded-lg p-4 border border-[#1f2937]/50 min-h-[100px] flex items-center justify-center">
              <span class="text-xs text-gray-500 italic">Loading candlesticks...</span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Right: Linking Tool (1 Col wide) -->
    <div class="flex flex-col gap-6">
      <div class="border border-[#1f2937] rounded-xl bg-[#111827]/20 p-6 flex flex-col gap-6">
        <div>
          <h2 class="text-xl font-bold text-white">Registry Linker Tool</h2>
          <p class="text-xs text-gray-400">Add active package ledgers to this project space.</p>
        </div>

        <% if @unlinked_repositories.empty? %>
          <p class="text-sm text-gray-500 italic py-2">All registered repository ledgers are already mapped to this environment or another project.</p>
        <% else %>
          <%= form_with(url: link_repository_project_path(@project), method: :post, class: "flex flex-col gap-4") do |form| %>
            <div class="flex flex-col gap-2">
              <%= form.label :repo_id, "Select Unlinked Repository", class: "text-xs font-semibold text-gray-400 uppercase tracking-wider" %>
              <%= form.select :repo_id, options_for_select(@unlinked_repositories.map { |r| ["#{r['owner']}/#{r['repo']} (ID: #{r['id']})", r["id"]] }), {}, class: "w-full bg-[#0b0f19] border border-[#1f2937] rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-[#10b981] transition-colors" %>
            </div>
            <%= form.submit "Link Selected Repository", class: "w-full py-3 rounded-lg bg-[#10b981] text-black font-bold text-xs cursor-pointer hover:bg-[#10b981]/90 transition-all uppercase tracking-wider" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/d3@7"></script>
<script src="https://cdn.jsdelivr.net/npm/js-yaml@4.1.0/dist/js-yaml.min.js"></script>
<script>
  document.addEventListener("turbo:load", initCandlesticks);

  if (document.readyState === "complete" || document.readyState === "interactive") {
    initCandlesticks();
  } else {
    document.addEventListener("DOMContentLoaded", initCandlesticks);
  }

  function initCandlesticks() {
    const charts = document.querySelectorAll(".candlestick-chart");
    charts.forEach(container => {
      if (container.getAttribute("data-initialized") === "true") return;
      container.setAttribute("data-initialized", "true");

      const url = container.getAttribute("data-url");
      fetch(url)
        .then(res => {
          if (!res.ok) throw new Error("Status: " + res.status);
          return res.text();
        })
        .then(yamlText => {
          const data = jsyaml.load(yamlText);
          renderChart(container, data);
        })
        .catch(err => {
          container.innerHTML = `<span class="text-xs text-red-500 font-semibold">Failed to load candlesticks: ${err.message}</span>`;
        });
    });
  }

  function semverToNumber(ver) {
    if (!ver || ver === "infinity") return null;
    const clean = ver.replace(/[^0-9.]/g, "");
    const parts = clean.split(".").map(x => parseInt(x, 10) || 0);
    while (parts.length < 3) {
      parts.push(0);
    }
    return parts[0] * 1000000 + parts[1] * 1000 + parts[2];
  }

  function renderChart(container, data) {
    container.innerHTML = ""; // Clear loader
    if (!data || data.length === 0) {
      container.innerHTML = `<span class="text-xs text-gray-500 italic">No package SemVer constraints found.</span>`;
      return;
    }

    // Group packages by manifest
    const groups = {};
    data.forEach(d => {
      const m = d.manifest || "package.json";
      if (!groups[m]) groups[m] = [];
      groups[m].push(d);
    });

    // Render a section for each manifest
    Object.entries(groups).forEach(([manifestName, groupData]) => {
      const subContainer = document.createElement("div");
      subContainer.className = "mb-8 border-b border-[#1f2937]/30 pb-6 last:border-0 last:pb-0";

      const title = document.createElement("h4");
      title.className = "text-xs font-semibold text-gray-400 mb-4 font-mono bg-[#111827]/40 px-3 py-2 rounded-lg border border-[#1f2937]/50 inline-block";
      title.innerText = `Manifest: ${manifestName}`;
      subContainer.appendChild(title);

      const chartDiv = document.createElement("div");
      chartDiv.className = "w-full";
      subContainer.appendChild(chartDiv);
      container.appendChild(subContainer);

      renderSingleChart(chartDiv, groupData);
    });
  }

  function renderSingleChart(container, data) {
    const rowHeight = 60;
    const margin = { top: 15, right: 80, bottom: 25, left: 160 };
    const chartWidth = container.clientWidth || 600;
    const width = chartWidth - margin.left - margin.right;
    const height = data.length * rowHeight;

    const svg = d3.select(container)
      .append("svg")
      .attr("width", chartWidth)
      .attr("height", height + margin.top + margin.bottom)
      .append("g")
      .attr("transform", `translate(${margin.left}, ${margin.top})`);

    data.forEach((d, idx) => {
      const y = idx * rowHeight + rowHeight / 2;

      const minVal = semverToNumber(d.min_version);
      const firstVal = semverToNumber(d.first_seen_version);
      const pinnedVal = semverToNumber(d.current_pinned_version);
      const latestVal = semverToNumber(d.latest_upstream_version);
      const isInfinity = d.max_version === "infinity";

      let maxVal = isInfinity
        ? Math.max(latestVal, pinnedVal) + (Math.max(latestVal, pinnedVal) - minVal || 1000) * 1.5
        : semverToNumber(d.max_version);
      if (maxVal <= minVal) maxVal = minVal + 1000;

      const xScale = d3.scaleLinear()
        .domain([minVal, maxVal])
        .range([0, width]);

      const g = svg.append("g");

      if (idx < data.length - 1) {
        svg.append("line")
          .attr("x1", -margin.left)
          .attr("y1", (idx + 1) * rowHeight)
          .attr("x2", width + margin.right)
          .attr("y2", (idx + 1) * rowHeight)
          .attr("stroke", "#1f2937")
          .attr("stroke-width", 1);
      }

      g.append("text")
        .attr("x", -10)
        .attr("y", y + 4)
        .attr("text-anchor", "end")
        .attr("fill", "#ffffff")
        .attr("font-size", "12px")
        .attr("font-family", "monospace")
        .attr("font-weight", "bold")
        .text(d.package);

      g.append("text")
        .attr("x", -10)
        .attr("y", y + 16)
        .attr("text-anchor", "end")
        .attr("fill", "#9ca3af")
        .attr("font-size", "10px")
        .attr("font-family", "monospace")
        .text(`(${d.constraint})`);

      const xMin = xScale(minVal);
      const xMax = isInfinity ? width : xScale(maxVal);

      g.append("line")
        .attr("x1", xMin)
        .attr("y1", y)
        .attr("x2", xMax)
        .attr("y2", y)
        .attr("stroke", "#4b5563")
        .attr("stroke-dasharray", isInfinity ? "4,4" : "none")
        .attr("stroke-width", 2);

      g.append("line")
        .attr("x1", xMin)
        .attr("y1", y - 6)
        .attr("x2", xMin)
        .attr("y2", y + 6)
        .attr("stroke", "#4b5563")
        .attr("stroke-width", 2);

      if (!isInfinity) {
        g.append("line")
          .attr("x1", xMax)
          .attr("y1", y - 6)
          .attr("x2", xMax)
          .attr("y2", y + 6)
          .attr("stroke", "#4b5563")
          .attr("stroke-width", 2);
      } else {
        g.append("text")
          .attr("x", xMax + 10)
          .attr("y", y + 4)
          .attr("fill", "#6b7280")
          .attr("font-size", "12px")
          .text("∞");
      }

      const xFirst = xScale(firstVal);
      const xLatest = xScale(latestVal);

      const bodyMin = Math.min(xFirst, xLatest);
      const bodyMax = Math.max(xFirst, xLatest);
      const bodyWidth = Math.max(2, bodyMax - bodyMin);

      const hasDrift = pinnedVal < latestVal;
      const bodyColor = hasDrift ? "#f59e0b" : "#10b981";

      g.append("rect")
        .attr("x", bodyMin)
        .attr("y", y - 5)
        .attr("width", bodyWidth)
        .attr("height", 10)
        .attr("fill", bodyColor)
        .attr("opacity", 0.4)
        .attr("rx", 2);

      const xPinned = xScale(pinnedVal);
      g.append("circle")
        .attr("cx", xPinned)
        .attr("cy", y)
        .attr("r", 5)
        .attr("fill", "#6366f1")
        .attr("stroke", "#ffffff")
        .attr("stroke-width", 1.5);

      g.append("text")
        .attr("x", xPinned)
        .attr("y", y - 10)
        .attr("text-anchor", "middle")
        .attr("fill", "#818cf8")
        .attr("font-size", "9px")
        .attr("font-family", "monospace")
        .text(d.current_pinned_version);

      g.append("text")
        .attr("x", xMin)
        .attr("y", y + 18)
        .attr("text-anchor", "middle")
        .attr("fill", "#6b7280")
        .attr("font-size", "8px")
        .attr("font-family", "monospace")
        .text(d.min_version);

      if (!isInfinity) {
        g.append("text")
          .attr("x", xMax)
          .attr("y", y + 18)
          .attr("text-anchor", "middle")
          .attr("fill", "#6b7280")
          .attr("font-size", "8px")
          .attr("font-family", "monospace")
          .text(d.max_version);
      }

      if (latestVal !== pinnedVal) {
        g.append("text")
          .attr("x", xLatest)
          .attr("y", y + 18)
          .attr("text-anchor", "middle")
          .attr("fill", "#f3f4f6")
          .attr("font-size", "9px")
          .attr("font-weight", "bold")
          .attr("font-family", "monospace")
          .text(d.latest_upstream_version);

        g.append("line")
          .attr("x1", xLatest)
          .attr("y1", y - 8)
          .attr("x2", xLatest)
          .attr("y2", y + 8)
          .attr("stroke", "#f59e0b")
          .attr("stroke-width", 1.5);
      }
    });
  }
</script>
