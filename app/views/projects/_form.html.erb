<%= form_with(model: project, class: "flex flex-col gap-5 max-w-md w-full") do |form| %>
  <% if project.errors.any? %>
    <div class="p-4 rounded-lg bg-[#ef4444]/10 border border-[#ef4444]/20 text-[#ef4444] text-xs font-semibold">
      <h2><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h2>
      <ul class="list-disc pl-4 mt-2">
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-2">
    <%= form.label :name, "Project Container Name", class: "text-xs font-semibold text-gray-400 uppercase tracking-wider" %>
    <%= form.text_field :name, placeholder: "e.g. Billing Infrastructure", class: "w-full bg-[#0b0f19] border border-[#1f2937] rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-[#10b981] transition-colors placeholder:text-gray-600" %>
  </div>

  <div class="flex gap-3 mt-2">
    <%= form.submit project.new_record? ? "Create Project" : "Update Project", class: "px-6 py-3 rounded-lg bg-[#10b981] text-black font-bold text-sm cursor-pointer hover:bg-[#10b981]/90 hover:shadow-lg hover:shadow-[#10b981]/15 transition-all uppercase tracking-wide" %>
    <%= link_to "Cancel", dashboard_path, class: "px-6 py-3 rounded-lg border border-[#1f2937] text-gray-400 hover:text-white text-sm font-bold uppercase tracking-wide flex items-center justify-center transition-colors" %>
  </div>
<% end %>
